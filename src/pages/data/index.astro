---
import { Database, ExternalLink, Search } from "@lucide/astro";
import {
	canonicalDataUrl,
	type ForkcastDataCall,
	type ForkcastDataEip,
	forkcastDataSnapshot,
} from "@/domain/forkcast-data/snapshot";
import BaseLayout from "@/layouts/BaseLayout.astro";

const eips = forkcastDataSnapshot.eips as ForkcastDataEip[];
const calls = forkcastDataSnapshot.calls as ForkcastDataCall[];
const snapshotId = forkcastDataSnapshot.snapshotId;
---

<BaseLayout title="Forkcast Data Snapshot" description="Pinned canonical data snapshot used by Forkcast.">
  <main class="min-h-screen bg-slate-50 p-6 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <div class="mx-auto max-w-5xl">
      <header class="mb-8 border-b border-slate-200 pb-6 dark:border-slate-700">
        <div class="mb-3 flex items-center gap-2 text-sm font-medium text-teal-700 dark:text-teal-300">
          <Database class="h-4 w-4" />
          Canonical data snapshot
        </div>
        <h1 class="text-3xl font-semibold tracking-tight">Forkcast data plane</h1>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600 dark:text-slate-400">
          This site is pinned to <code>{snapshotId}</code>. Human pages render views over these JSON and Markdown read models.
        </p>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="inline-flex items-center gap-1.5 rounded border border-slate-200 bg-white px-3 py-1.5 text-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" href={canonicalDataUrl("/latest/catalog.json")} target="_blank" rel="noopener noreferrer">
            Catalog <ExternalLink class="h-3.5 w-3.5" />
          </a>
          <a class="inline-flex items-center gap-1.5 rounded border border-slate-200 bg-white px-3 py-1.5 text-sm hover:bg-slate-50 dark:border-slate-700 dark:bg-slate-800 dark:hover:bg-slate-700" href={canonicalDataUrl("/latest/search/index.json")} target="_blank" rel="noopener noreferrer">
            Search index <Search class="h-3.5 w-3.5" />
          </a>
        </div>
      </header>

      <section class="grid grid-cols-1 gap-4 md:grid-cols-3">
        <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-2xl font-semibold">{forkcastDataSnapshot.counts.eips}</div>
          <div class="text-sm text-slate-600 dark:text-slate-400">EIP read models</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-2xl font-semibold">{forkcastDataSnapshot.counts.calls}</div>
          <div class="text-sm text-slate-600 dark:text-slate-400">Call read models</div>
        </div>
        <div class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
          <div class="text-2xl font-semibold">{forkcastDataSnapshot.counts.decisions}</div>
          <div class="text-sm text-slate-600 dark:text-slate-400">Decision records</div>
        </div>
      </section>

      <section class="mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <div>
          <h2 class="mb-3 text-lg font-medium">Pinned EIPs</h2>
          <div class="space-y-2">
            {eips.slice(0, 8).map((eip) => (
              <a class="block rounded border border-slate-200 bg-white p-3 text-sm hover:border-teal-300 dark:border-slate-700 dark:bg-slate-800" href={`/eips/${eip.id}`}>
                <span class="font-mono text-xs text-teal-700 dark:text-teal-300">EIP-{eip.id}</span>
                <span class="ml-2">{eip.title}</span>
              </a>
            ))}
          </div>
        </div>
        <div>
          <h2 class="mb-3 text-lg font-medium">Pinned Calls</h2>
          <div class="space-y-2">
            {calls.slice(0, 8).map((call) => (
              <a class="block rounded border border-slate-200 bg-white p-3 text-sm hover:border-teal-300 dark:border-slate-700 dark:bg-slate-800" href={`/calls/${call.series}/${call.number}`}>
                <span class="font-mono text-xs text-teal-700 dark:text-teal-300">{call.series.toUpperCase()} #{call.number}</span>
                <span class="ml-2">{call.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
