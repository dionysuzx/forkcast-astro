---
import { ArrowLeft, ExternalLink, Info } from "@lucide/astro";
import {
	type DevnetSpec,
	getDevnetSeriesSiblings,
	getDevnetSpec,
} from "@/domain/devnets/devnet";
import {
	type DevnetRouteEntry,
	type DevnetSeriesCard,
	devnetRouteEntries,
	getDevnetSeries,
} from "@/domain/devnets/series";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () =>
	devnetRouteEntries().map((entry) => ({
		params: { id: entry.id },
		props: {
			entry,
			series: getDevnetSeries(entry.id) ?? null,
			spec: getDevnetSpec(entry.id) ?? null,
		},
	}));

interface Props {
	entry: DevnetRouteEntry;
	series: DevnetSeriesCard | null;
	spec: DevnetSpec | null;
}

const { entry, series, spec } = Astro.props;
const pageTitle = spec?.title ?? entry.id;
const pageDescription = spec
	? `Devnet spec for ${spec.id}.`
	: (series?.description ?? `Active devnet network detail for ${entry.id}.`);
const siblings = spec ? getDevnetSeriesSiblings(spec.id) : null;
const clientSupportSections = spec
	? [
			{ title: "Execution Layer Client Support", matrix: spec.elClientSupport },
			{ title: "Consensus Layer Client Support", matrix: spec.clClientSupport },
		]
	: [];

const formatScrapedDate = (value: string): string =>
	new Intl.DateTimeFormat("en-US", {
		month: "short",
		day: "numeric",
		year: "numeric",
		timeZone: "UTC",
	}).format(new Date(value));

const escapeHtml = (value: string): string =>
	value.replace(/[&<>"']/g, (character) => {
		const entities: Record<string, string> = {
			"&": "&amp;",
			"<": "&lt;",
			">": "&gt;",
			'"': "&quot;",
			"'": "&#39;",
		};
		return entities[character] ?? character;
	});

const renderAnnouncement = (value: string): string =>
	escapeHtml(value)
		.replace(
			/\bEIP-(\d+)\b/g,
			'<a href="/eips/$1" class="font-semibold underline underline-offset-2 hover:text-blue-700 dark:hover:text-blue-100">EIP-$1</a>',
		)
		.replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>");

const statusBadgeClass = (status: string): string => {
	switch (status) {
		case "updated":
			return "bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300";
		case "new":
		case "new_optional":
			return "bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300";
		default:
			return "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400";
	}
};

const statusLabel = (status: string): string => {
	switch (status) {
		case "updated":
			return "Updated";
		case "new":
			return "New";
		case "new_optional":
			return "New";
		case "optional":
			return "Optional";
		default:
			return status.replaceAll("_", " ");
	}
};

const supportCell = (status: string | null | undefined) => {
	switch (status) {
		case "supported":
			return {
				label: "✓",
				title: "Supported",
				className:
					"bg-green-100 text-green-800 dark:bg-green-900/40 dark:text-green-300",
			};
		case "not_supported":
			return {
				label: "✗",
				title: "Not supported",
				className:
					"bg-red-100 text-red-800 dark:bg-red-900/40 dark:text-red-300",
			};
		case "in_progress":
			return {
				label: "🔨",
				title: "In progress",
				className:
					"bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300",
			};
		case "unknown":
		case null:
		case undefined:
			return {
				label: "?",
				title: "Unknown",
				className:
					"bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400",
			};
		default:
			return {
				label: status,
				title: status,
				className:
					"bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-400",
			};
	}
};

const supportCellSizeClass = (status: string | null | undefined): string =>
	supportCell(status).label.length <= 2
		? "inline-flex h-8 w-8 items-center justify-center text-sm"
		: "inline-block whitespace-nowrap px-1.5 py-0.5 text-xs";
---

<BaseLayout title={`${pageTitle} - Forkcast`} description={pageDescription}>
  <div class="min-h-screen bg-white p-6 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <div class="mx-auto max-w-4xl">
      <div class="mb-6 flex items-center justify-between gap-3">
        <a href="/devnets" class="inline-flex items-center gap-1.5 text-sm text-slate-500 transition-colors hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">
          <ArrowLeft class="h-4 w-4" />
          Back to Devnets
        </a>
        {siblings && (
          <nav class="flex items-center gap-1 text-sm" aria-label="Devnet series navigation">
            {siblings.previous ? (
              <a href={`/devnets/${siblings.previous}`} class="rounded px-2 py-1 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" title={siblings.previous}>← Prev</a>
            ) : (
              <span class="px-2 py-1 text-slate-300 dark:text-slate-600">← Prev</span>
            )}
            <span class="text-slate-300 dark:text-slate-600">|</span>
            {siblings.next ? (
              <a href={`/devnets/${siblings.next}`} class="rounded px-2 py-1 text-slate-500 transition-colors hover:bg-slate-100 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-800 dark:hover:text-slate-200" title={siblings.next}>Next →</a>
            ) : (
              <span class="px-2 py-1 text-slate-300 dark:text-slate-600">Next →</span>
            )}
          </nav>
        )}
      </div>

      {spec ? (
        <>
          <header class="mb-8">
            <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">{spec.title}</h1>
            <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-slate-500 dark:text-slate-400">
              <a href={spec.sourceUrl} target="_blank" rel="noopener noreferrer" class="underline decoration-1 underline-offset-2 transition-colors hover:text-purple-600 dark:hover:text-purple-400">
                View Source
              </a>
              <span>·</span>
              <span>Scraped {formatScrapedDate(spec.scrapedAt)}</span>
            </div>
          </header>

          {spec.announcements.length > 0 && (
            <section class="mb-8 divide-y divide-blue-200 overflow-hidden rounded-lg border border-blue-200 bg-blue-50 text-sm text-blue-900 dark:divide-blue-800 dark:border-blue-800 dark:bg-blue-900/20 dark:text-blue-200">
              {spec.announcements.map((announcement) => (
                <div class="flex gap-3 px-4 py-3">
                  <Info class="mt-0.5 h-4 w-4 shrink-0 text-blue-400 dark:text-blue-500" aria-hidden="true" />
                  <span set:html={renderAnnouncement(announcement)} />
                </div>
              ))}
            </section>
          )}

          {(spec.specReferences.consensusSpecs || spec.specReferences.executionSpecs) && (
            <div class="mb-8 flex flex-wrap gap-3">
              {spec.specReferences.consensusSpecs && (
                <a href={spec.specReferences.consensusSpecs.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                  Consensus Specs
                  <span class="rounded bg-purple-100 px-1.5 py-0.5 font-mono text-purple-700 text-xs dark:bg-purple-900/40 dark:text-purple-300">{spec.specReferences.consensusSpecs.version}</span>
                </a>
              )}
              {spec.specReferences.executionSpecs && (
                <a href={spec.specReferences.executionSpecs.url} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-slate-100 px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-300 dark:hover:bg-slate-700">
                  Execution Specs
                  <span class="rounded bg-purple-100 px-1.5 py-0.5 font-mono text-purple-700 text-xs dark:bg-purple-900/40 dark:text-purple-300">{spec.specReferences.executionSpecs.version}</span>
                </a>
              )}
            </div>
          )}

          {spec.eips.length > 0 && (
            <section class="mt-8">
              <h2 class="mb-4 text-xl font-bold text-slate-900 dark:text-slate-100">EIP List</h2>
              <div class="-mx-4 overflow-x-auto px-4">
                <table class="w-full text-sm">
                  <thead>
                    <tr class="border-b border-slate-200 dark:border-slate-700">
                      <th class="py-2 pr-4 text-left font-medium text-slate-600 dark:text-slate-400">EIP</th>
                      <th class="py-2 pr-4 text-left font-medium text-slate-600 dark:text-slate-400">Title</th>
                      <th class="py-2 text-left font-medium text-slate-600 dark:text-slate-400">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    {spec.eips.map((eip) => (
                      <tr class="border-b border-slate-100 dark:border-slate-800">
                        <td class="py-2 pr-4">
                          <a href={`/eips/${eip.number}`} data-astro-prefetch class="font-medium text-purple-600 transition hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300">
                            EIP-{eip.number}
                          </a>
                        </td>
                        <td class="py-2 pr-4 text-slate-700 dark:text-slate-300">{eip.title}</td>
                        <td class="py-2">
                          {eip.status && (
                            eip.status === "new_optional" ? (
                              <span class="inline-flex gap-1">
                                <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${statusBadgeClass("new")}`}>New</span>
                                <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${statusBadgeClass("optional")}`}>Optional</span>
                              </span>
                            ) : (
                              <span class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${statusBadgeClass(eip.status)}`}>{statusLabel(eip.status)}</span>
                            )
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )}

          {clientSupportSections.map(({ title, matrix }) => (
            matrix.clients.length > 0 && (
              <section class="mt-8">
                <h2 class="mb-4 text-xl font-bold text-slate-900 dark:text-slate-100">{title}</h2>
                <div class="-mx-4 overflow-x-auto px-4">
                  <table class="w-full text-sm">
                    <thead>
                      <tr class="border-b border-slate-200 dark:border-slate-700">
                        <th class="py-2 pr-4 text-left font-medium text-slate-600 dark:text-slate-400">EIP</th>
                        {matrix.clients.map((client) => (
                          <th class="px-2 py-2 text-center font-medium text-slate-600 dark:text-slate-400">{client}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {matrix.matrix.map((row) => (
                        <tr class="border-slate-100 border-b dark:border-slate-800">
                          <td class="whitespace-nowrap py-2 pr-4 text-slate-700 dark:text-slate-300">{row.label}</td>
                          {matrix.clients.map((client) => {
                            const support = supportCell(row.support[client]);
                            return (
                              <td class="px-2 py-2 text-center">
                                <span
                                  class:list={[
                                    supportCellSizeClass(row.support[client]),
                                    "rounded font-medium",
                                    support.className,
                                  ]}
                                  title={support.title}
                                >
                                  {support.label}
                                </span>
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </section>
            )
          ))}
        </>
      ) : (
        <header class="mb-8">
          <h1 class="text-3xl font-bold text-slate-900 dark:text-slate-100">{entry.id}</h1>
          <p class="mt-3 max-w-3xl text-sm leading-relaxed text-slate-600 dark:text-slate-400">
            {series?.description ?? pageDescription}
          </p>
          {entry.kind === "network" && (
            <a href={`https://ethpandaops.io/networks/${entry.id}/`} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex items-center gap-1 text-sm text-purple-600 underline underline-offset-2 dark:text-purple-400">
              ethPandaOps Dashboard
              <ExternalLink class="h-4 w-4" />
            </a>
          )}
          {series && series.activeKeys.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2">
              {series.activeKeys.map((key) => (
                <a href={`/devnets/${key}`} class="rounded bg-slate-100 px-2 py-1 font-mono text-xs font-medium text-purple-600 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-purple-400 dark:hover:bg-slate-700">
                  {key}
                </a>
              ))}
            </div>
          )}
        </header>
      )}
    </div>
  </div>
</BaseLayout>
