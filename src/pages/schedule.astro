---
import SchedulePlanner from "@/components/schedule/SchedulePlanner";
import {
	buildSchedulePlan,
	phaseDateLabel,
	phaseForFork,
	phaseMilestones,
} from "@/domain/schedule/planning";
import BaseLayout from "@/layouts/BaseLayout.astro";

const schedulePlan = buildSchedulePlan();
const displayPhases = schedulePlan.phases.filter(
	(phase) => phase.id !== "fork-focus",
);

const statusClass = (status: string): string => {
	switch (status) {
		case "completed":
			return "bg-green-100 text-green-800 dark:bg-green-900/30 dark:text-green-300";
		case "in-progress":
			return "bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-300";
		default:
			return "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300";
	}
};

const settingGroups = [
	{ id: "headliners", label: "Headliners" },
	{ id: "scope", label: "Scope" },
	{ id: "devnets", label: "Devnets" },
	{ id: "testnets", label: "Testnets" },
] as const;

const itemDate = (item: { date?: string; projectedDate?: string }): string =>
	item.date ?? item.projectedDate ?? "TBD";
---

<BaseLayout title="ACD Planning Sandbox - Forkcast" description="Internal planning tool for Ethereum core developers. Explore hypothetical upgrade timelines.">
  <SchedulePlanner client:load>
    <div slot="fallback" class="min-h-screen bg-slate-50 p-6 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
      <div class="mx-auto max-w-7xl">
        <header class="mb-6">
          <h1 class="mb-2 text-xl font-semibold text-slate-900 dark:text-slate-100">ACD Planning Sandbox</h1>
          <p class="max-w-3xl text-sm text-slate-500 dark:text-slate-400">
            Internal planning tool for ACD facilitators, client teams, and testers. Dates shown are hypothetical projections, not commitments.
          </p>
          <p class="mt-1 text-xs text-slate-500 dark:text-slate-400">
            Edit and lock dates to explore planning scenarios. Changes are saved automatically to your browser.
          </p>
        </header>

        <div class="mb-6 grid gap-3 md:grid-cols-3">
          {schedulePlan.forks.map((fork) => (
            <article class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
              <div class="flex items-start justify-between gap-3">
                <div>
                  {fork.metaThreadUrl ? (
                    <a href={fork.metaThreadUrl} target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-900 text-sm transition hover:text-purple-600 dark:text-slate-100 dark:hover:text-purple-400">
                      {fork.name}
                    </a>
                  ) : (
                    <h2 class="font-semibold text-slate-900 text-sm dark:text-slate-100">{fork.name}</h2>
                  )}
                  <p class="mt-1 text-slate-500 text-xs dark:text-slate-400">Mainnet {fork.mainnetDate}</p>
                </div>
                <span class="rounded bg-purple-100 px-2 py-1 font-medium text-purple-700 text-xs dark:bg-purple-900/30 dark:text-purple-300">{fork.devnetCount} devnets</span>
              </div>
            </article>
          ))}
        </div>

        <section class="mb-6 overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
          <div class="border-slate-200 border-b p-5 dark:border-slate-700">
            <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Fork Timeline Planning</h2>
            <p class="mt-1 text-sm text-slate-600 dark:text-slate-300">Default projections using the current planning assumptions.</p>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full min-w-[960px] text-sm">
              <thead class="bg-slate-50 dark:bg-slate-700/50">
                <tr>
                  <th class="w-56 border-slate-200 border-r px-3 py-2 text-left font-semibold text-slate-600 text-xs uppercase tracking-wider dark:border-slate-600 dark:text-slate-300">Phase</th>
                  {schedulePlan.forks.map((fork) => (
                    <th class="px-3 py-2 text-left font-semibold text-slate-600 text-xs uppercase tracking-wider dark:text-slate-300">{fork.name}</th>
                  ))}
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200 dark:divide-slate-700">
                {displayPhases.map((phase) => (
                  <tr>
                    <th class="border-slate-200 border-r bg-slate-50 px-3 py-3 text-left align-top dark:border-slate-700 dark:bg-slate-900/40">
                      <span class="font-medium text-slate-900 dark:text-slate-100">{phase.title}</span>
                      <span class="mt-1 block text-slate-500 text-xs dark:text-slate-400">{phase.duration}</span>
                    </th>
                    {schedulePlan.forks.map((fork) => {
                      const forkPhase = phaseForFork(fork, phase.id);
                      const milestones = phaseMilestones(forkPhase);
                      return (
                        <td class="px-3 py-3 align-top">
                          {forkPhase ? (
                            <div>
                              <div class="mb-1 flex flex-wrap items-center gap-2">
                                <span class={`rounded px-1.5 py-0.5 font-medium text-[10px] uppercase ${statusClass(forkPhase.status)}`}>{forkPhase.status}</span>
                                <span class="font-medium text-slate-800 text-xs dark:text-slate-200">{phaseDateLabel(forkPhase)}</span>
                              </div>
                              {forkPhase.progressNotes && <p class="text-slate-500 text-xs leading-relaxed dark:text-slate-400">{forkPhase.progressNotes}</p>}
                              {milestones.length > 0 && (
                                <ul class="mt-2 space-y-1">
                                  {milestones.slice(0, 6).map((item) => (
                                    <li class="flex justify-between gap-3 text-xs">
                                      <span class="text-slate-600 dark:text-slate-300">{item.name}</span>
                                      <span class="shrink-0 text-slate-400 dark:text-slate-500">{itemDate(item)}</span>
                                    </li>
                                  ))}
                                </ul>
                              )}
                            </div>
                          ) : (
                            <span class="text-slate-400 text-xs dark:text-slate-500">Not formalized</span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <section class="grid gap-3 md:grid-cols-4">
          {settingGroups.map((group) => {
            const settings = schedulePlan.durationSettings.filter((setting) => setting.group === group.id);
            return (
              <article class="rounded-lg border border-slate-200 bg-white p-4 dark:border-slate-700 dark:bg-slate-800">
                <h2 class="mb-3 font-semibold text-slate-900 text-sm dark:text-slate-100">{group.label}</h2>
                <dl class="space-y-2">
                  {settings.map((setting) => (
                    <div class="flex items-start justify-between gap-3">
                      <dt>
                        <span class="block text-slate-700 text-xs dark:text-slate-300">{setting.label}</span>
                        <span class="block text-slate-400 text-[11px] leading-snug dark:text-slate-500">{setting.description}</span>
                      </dt>
                      <dd class="rounded bg-slate-100 px-2 py-0.5 font-mono text-slate-700 text-xs dark:bg-slate-700 dark:text-slate-300">{setting.days}d</dd>
                    </div>
                  ))}
                </dl>
              </article>
            );
          })}
        </section>
      </div>
    </div>
  </SchedulePlanner>
</BaseLayout>
