---
import {
	CalendarDays,
	ChevronDown,
	Maximize2,
	Minimize2,
	Pin,
	Search,
	X,
} from "@lucide/astro";
import BreakoutSelector from "@/components/calls/BreakoutSelector.astro";
import StructuredDecision from "@/components/calls/StructuredDecision.astro";
import { getCallArtifacts } from "@/domain/calls/artifacts";
import {
	callByIssue,
	callByPath,
	callTypes,
	getCallNeighbors,
	getCallTitle,
	type ProtocolCall,
	protocolCalls,
} from "@/domain/calls/call";
import {
	parseChatLog,
	parseTranscript,
	secondsToTimestamp as formatSecondsTimestamp,
	timestampToSeconds as timestampToSecondsValue,
} from "@/domain/calls/call-log";
import { canonicalCallDataUrl } from "@/domain/forkcast-data/snapshot";
import { breakoutArtifactsForCall } from "@/domain/protocol-events/breakout-artifacts";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () => [
	...protocolCalls.map((call) => ({
		params: { path: call.path },
		props: { call },
	})),
	...protocolCalls.flatMap((call) =>
		call.issue
			? [
					{
						params: { path: String(call.issue) },
						props: { call, aliasFor: call.path },
					},
				]
			: [],
	),
	...callTypes.map((type) => ({
		params: { path: type },
		props: { filterType: type },
	})),
];

interface Props {
	call?: ProtocolCall;
	aliasFor?: string;
	filterType?: string;
}

const { call: providedCall, aliasFor, filterType } = Astro.props;
const pathParam = Astro.params.path ?? "";
const call =
	providedCall ?? callByPath.get(pathParam) ?? callByIssue.get(pathParam);

const youtubeId = (url: string | null) => {
	if (!url) return null;
	const match = url.match(
		/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([^&\n?#]+)/,
	);
	return match?.[1] ?? url;
};

const artifacts = call ? getCallArtifacts(call) : null;
const transcript = artifacts ? parseTranscript(artifacts.transcript) : [];
const chatEntries = artifacts ? parseChatLog(artifacts.chat) : [];
const videoId = artifacts ? youtubeId(artifacts.videoUrl) : null;
const syncConfig = artifacts?.config?.sync ?? null;
const transcriptStartSeconds = syncConfig?.transcriptStartTime
	? timestampToSecondsValue(syncConfig.transcriptStartTime)
	: null;
const videoStartSeconds = syncConfig?.videoStartTime
	? timestampToSecondsValue(syncConfig.videoStartTime)
	: null;
const hasTranscriptSync =
	transcriptStartSeconds !== null && videoStartSeconds !== null;
const transcriptOffsetSeconds = hasTranscriptSync
	? transcriptStartSeconds - videoStartSeconds
	: 0;
const displayTranscriptTimestamp = (timestamp: string): string =>
	hasTranscriptSync
		? formatSecondsTimestamp(timestampToSecondsValue(timestamp) - transcriptOffsetSeconds)
		: timestamp;
const displaySummaryTimestamp = (timestamp: string | null | undefined): string | null =>
	timestamp ? displayTranscriptTimestamp(timestamp) : null;
const visibleTranscript =
	transcriptStartSeconds === null
		? transcript
		: transcript.filter((entry) => entry.seconds >= transcriptStartSeconds);
const displayChatTimestamp = displayTranscriptTimestamp;
const visibleChatEntries =
	transcriptStartSeconds === null
		? chatEntries
		: chatEntries.filter((entry) => entry.seconds >= transcriptStartSeconds);
const breakoutPanels = call ? breakoutArtifactsForCall(call.path) : [];
const breakoutOptions = breakoutPanels.map((panel) => ({
	kind: panel.breakout.kind,
	label: panel.label,
}));
const callNeighbors = call ? getCallNeighbors(call) : { previous: null, next: null };

const tldrSections = artifacts?.tldr
	? [
			{
				title: "Action Items",
				items: (artifacts.tldr.action_items ?? []).map((item) => ({
					timestamp: item.timestamp,
					text: `${item.owner}: ${item.action}`,
				})),
			},
			{
				title: "Targets",
				items: (artifacts.tldr.targets ?? []).map((item) => ({
					timestamp: item.timestamp,
					text: item.target,
				})),
			},
		].filter((section) => section.items.length > 0)
	: [];
const fallbackTldrDecisions =
	artifacts?.tldr?.decisions?.map((item) => ({
		timestamp: item.timestamp,
		text: item.decision,
	})) ?? [];
const tldrHighlightCount = artifacts?.tldr
	? Object.values(artifacts.tldr.highlights ?? {}).reduce(
			(total, highlights) => total + highlights.length,
			0,
		)
	: 0;
const tldrActionCount = artifacts?.tldr?.action_items?.length ?? 0;
const tldrDecisionCount = artifacts?.tldr?.decisions?.length ?? 0;
const summaryDecisionCount = artifacts?.keyDecisions.length ?? tldrDecisionCount;
const issueNumber = artifacts?.config?.issue ?? call?.issue;
	---

{
  filterType ? (
    <BaseLayout title="Protocol Calls - Forkcast" description="Filtered protocol call route">
      <meta http-equiv="refresh" content={`0; url=/calls?filter=${filterType}`} />
      <div class="min-h-screen bg-slate-50 p-6 dark:bg-slate-900">
        <div class="mx-auto max-w-4xl rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <p class="text-sm text-slate-600 dark:text-slate-400">
            Redirecting to <a class="text-purple-600 underline" href={`/calls?filter=${filterType}`}>filtered calls</a>.
          </p>
        </div>
      </div>
    </BaseLayout>
  ) : call && artifacts ? (
        <BaseLayout wide showCallSearch title={`${getCallTitle(call)} - Forkcast`} description={`Notes and recording for ${getCallTitle(call)} from ${call.date}.`}>
          {aliasFor && <meta http-equiv="refresh" content={`0; url=/calls/${aliasFor}`} />}
          <div id="call-page-root" data-theater="false" class="min-h-screen bg-slate-50 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
            <button
              type="button"
              data-open-call-search
              class="fixed right-6 bottom-6 z-40 rounded-full bg-blue-600 p-3 text-white shadow-lg transition-all duration-200 hover:bg-blue-700 hover:shadow-xl sm:hidden dark:bg-blue-500 dark:hover:bg-blue-600"
              aria-label="Search this call"
            >
              <Search class="h-5 w-5" />
            </button>

            <div class="call-workspace mx-auto grid max-w-[1800px] grid-cols-1 gap-4 px-4 py-4 sm:px-6 lg:grid-cols-[minmax(0,1.7fr)_minmax(22rem,0.95fr)] lg:items-start xl:px-8 2xl:px-10">
	              <section data-call-view="main" data-video-panel class="min-w-0">
	                <div class="call-video-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-800">
	                  {breakoutPanels.length > 0 && (
	                    <BreakoutSelector callPath={call.path} options={breakoutOptions} />
	                  )}
	                  <div class="call-video-body">
                      {videoId ? (
                        <div class="call-video-frame overflow-hidden rounded-lg bg-black">
                          <iframe
                            src={`https://www.youtube.com/embed/${videoId}?modestbranding=1&rel=0&enablejsapi=1`}
                            title={`${getCallTitle(call)} video`}
                            class="h-full w-full"
                            loading="lazy"
                            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen
                          />
                        </div>
                      ) : (
                        <div class="call-video-frame flex items-center justify-center rounded-lg bg-slate-100 text-sm text-slate-500 dark:bg-slate-700 dark:text-slate-400">
                          Recording unavailable
                        </div>
                      )}
                    </div>
                    <div class="mt-4 border-t border-slate-200 pt-3 dark:border-slate-700">
                      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                        <h1 class="text-base font-semibold text-slate-900 dark:text-slate-100">{getCallTitle(call)}</h1>
                        {call.date && (
                          <>
                            <span class="hidden text-slate-300 sm:inline dark:text-slate-600">|</span>
                            <span class="flex items-center gap-1.5 font-medium text-slate-700 dark:text-slate-200">
                              <CalendarDays class="h-4 w-4 text-slate-500 dark:text-slate-400" />
                              {call.date}
                            </span>
                          </>
                        )}
                        {issueNumber && (
                          <>
                            <span class="hidden text-slate-300 sm:inline dark:text-slate-600">|</span>
                            <span class="flex items-center gap-1.5 text-slate-600 dark:text-slate-300">
                              <Pin class="h-4 w-4 text-slate-500 dark:text-slate-400" />
                              Agenda:
                              <a href={`https://github.com/ethereum/pm/issues/${issueNumber}`} target="_blank" rel="noopener noreferrer" class="font-medium text-blue-600 underline decoration-1 underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-200">
                                #{issueNumber}
                              </a>
                            </span>
                          </>
                        )}
                        {call && (
                          <>
                            <span class="hidden text-slate-300 sm:inline dark:text-slate-600">|</span>
                            <a href={canonicalCallDataUrl(call)} target="_blank" rel="noopener noreferrer" class="font-mono text-xs text-teal-700 underline decoration-1 underline-offset-2 hover:text-teal-900 dark:text-teal-300 dark:hover:text-teal-100">
                              canonical JSON
                            </a>
                          </>
                        )}
                        <span class="flex-1" />
                        <button id="call-theater-toggle" type="button" data-theater-toggle class="hidden shrink-0 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-normal text-slate-500 text-xs transition-colors hover:bg-slate-50 hover:text-slate-700 lg:inline-flex dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-300">
                          <Maximize2 data-theater-expand class="h-4 w-4" />
                          <Minimize2 data-theater-collapse class="hidden h-4 w-4" />
                          <span data-theater-label>Theater Mode</span>
                        </button>
                      </div>
                      {(callNeighbors.previous || callNeighbors.next) && (
                        <div data-theater-call-nav class="mt-3 hidden items-center justify-between gap-2 border-slate-200 border-t pt-3 dark:border-slate-700">
                          {callNeighbors.previous ? (
                            <a href={`/calls/${callNeighbors.previous.path}`} data-astro-prefetch class="group -m-2 flex flex-1 flex-col items-start gap-0.5 rounded-lg p-2 transition-colors hover:bg-slate-100 dark:hover:bg-slate-700/50">
                              <span class="flex items-center gap-1 text-slate-500 text-xs dark:text-slate-400">
                                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                                </svg>
                                Previous
                              </span>
                              <span class="font-medium text-slate-700 text-sm transition-colors group-hover:text-blue-600 dark:text-slate-200 dark:group-hover:text-blue-400">
                                {getCallTitle(callNeighbors.previous)}
                              </span>
                            </a>
                          ) : (
                            <span class="flex-1" />
                          )}
                          {callNeighbors.next ? (
                            <a href={`/calls/${callNeighbors.next.path}`} data-astro-prefetch class="group -m-2 flex flex-1 flex-col items-end gap-0.5 rounded-lg p-2 text-right transition-colors hover:bg-slate-100 dark:hover:bg-slate-700/50">
                              <span class="flex items-center gap-1 text-slate-500 text-xs dark:text-slate-400">
                                Next
                                <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                              </span>
                              <span class="font-medium text-slate-700 text-sm transition-colors group-hover:text-blue-600 dark:text-slate-200 dark:group-hover:text-blue-400">
                                {getCallTitle(callNeighbors.next)}
                              </span>
                            </a>
                          ) : (
                            <span class="flex-1" />
                          )}
                        </div>
                      )}
                    </div>
                  </div>
	              </section>

	              {breakoutPanels.map((panel) => (
	                <section data-call-view={panel.breakout.kind} data-video-panel hidden class="min-w-0">
	                  <div class="call-video-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-800">
	                    <BreakoutSelector callPath={call.path} options={breakoutOptions} />
	                    <div class="call-video-body">
	                      <div class="call-video-frame overflow-hidden rounded-lg bg-black">
	                        <iframe
	                          src={`https://www.youtube.com/embed/${youtubeId(panel.breakout.videoUrl)}?modestbranding=1&rel=0&enablejsapi=1`}
	                          title={`${getCallTitle(call)} ${panel.label} breakout video`}
	                          class="h-full w-full"
	                          loading="lazy"
	                          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
	                          allowfullscreen
	                        />
	                      </div>
	                    </div>
	                    <div class="mt-4 border-t border-slate-200 pt-3 dark:border-slate-700">
	                      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
	                        <h1 class="text-base font-semibold text-slate-900 dark:text-slate-100">{getCallTitle(call)} — {panel.label} Breakout</h1>
	                        <span class="flex-1" />
	                        <button type="button" data-theater-toggle class="hidden shrink-0 items-center gap-1.5 rounded-lg border border-slate-200 bg-white px-2.5 py-1 font-normal text-slate-500 text-xs transition-colors hover:bg-slate-50 hover:text-slate-700 lg:inline-flex dark:border-slate-700 dark:bg-slate-800 dark:text-slate-400 dark:hover:bg-slate-700 dark:hover:text-slate-300">
	                          <Maximize2 data-theater-expand class="h-4 w-4" />
	                          <Minimize2 data-theater-collapse class="hidden h-4 w-4" />
	                          <span data-theater-label>Theater Mode</span>
	                        </button>
	                      </div>
	                    </div>
	                  </div>
	                </section>
	              ))}
	
	              <section data-call-view="main" class="call-side-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md lg:col-start-2 dark:border-slate-700 dark:bg-slate-800">
                  <h2 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Transcript</h2>
	                <div class="min-h-0 flex-1 space-y-1 overflow-y-auto pr-2">
	                  {visibleTranscript.length ? (
	                    visibleTranscript.map((entry, index) => {
	                      const displayTimestamp = displayTranscriptTimestamp(entry.timestamp);
                        const speakerMatch = entry.text.match(/^([^:]{1,80}):\s*(.*)$/);
                        const transcriptSpeaker = speakerMatch?.[1];
                        const transcriptText = speakerMatch?.[2] ?? entry.text;
	                      return (
	                        <article
	                          id={entry.fragment}
	                          data-call-entry
	                          data-kind="transcript"
                            data-current={String(index === 0)}
	                          data-timestamp={displayTimestamp}
	                          data-seconds={timestampToSecondsValue(displayTimestamp)}
	                          tabindex="-1"
	                          class="searchable group -mx-2 flex cursor-pointer gap-3 rounded border-l-2 border-transparent px-2 py-1 text-sm leading-relaxed text-slate-700 transition-colors hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700/30"
	                        >
	                          <a href={`#t=${displayTimestamp}`} data-transcript-link class="mt-0.5 shrink-0 font-mono text-slate-500 text-xs hover:text-purple-700 dark:text-slate-400 dark:hover:text-purple-300" style="min-width: 64px;">{displayTimestamp}</a>
	                          <div class="min-w-0 flex-1">
                              {transcriptSpeaker && (
                                <span data-transcript-speaker class="mr-2 font-medium text-slate-700 dark:text-slate-300">{transcriptSpeaker}:</span>
                              )}
                              <span data-transcript-text class="break-words text-slate-600 dark:text-slate-400">{transcriptText}</span>
                            </div>
	                        </article>
	                      );
	                    })
	                  ) : (
	                    <div class="flex min-h-48 flex-col items-center justify-center text-center">
	                      <p class="mb-1 font-medium text-slate-700 text-sm dark:text-slate-300">Transcript pending</p>
	                      <p class="text-slate-500 text-xs dark:text-slate-400">The transcript will be available after the call</p>
	                    </div>
                  )}
	                </div>
	              </section>

	              {breakoutPanels.map((panel) => (
	                <section data-call-view={panel.breakout.kind} hidden class="call-side-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md lg:col-start-2 dark:border-slate-700 dark:bg-slate-800">
	                  <h2 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Transcript</h2>
	                  <div class="flex min-h-0 flex-1 flex-col items-center justify-center text-center">
	                    <p class="mb-1 font-medium text-slate-700 text-sm dark:text-slate-300">Transcript pending</p>
	                    <p class="text-slate-500 text-xs dark:text-slate-400">Transcripts for breakouts are not yet processed</p>
	                  </div>
	                </section>
	              ))}
	
	              <section data-call-view="main" class="call-side-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md lg:col-start-2 dark:border-slate-700 dark:bg-slate-800">
                  <h2 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">Chat Logs</h2>
	                <div class="min-h-0 flex-1 space-y-2 overflow-y-auto pr-2">
	                  {visibleChatEntries.length ? (
	                    visibleChatEntries.map((entry) => {
	                      const displayTimestamp = displayChatTimestamp(entry.timestamp);
	                      return (
	                        <article
	                          id={entry.fragment}
	                          data-call-entry
	                          data-kind="chat"
	                          data-timestamp={displayTimestamp}
	                          data-seconds={timestampToSecondsValue(displayTimestamp)}
	                          tabindex="-1"
	                          class="searchable rounded border border-transparent px-2 py-1 text-xs leading-relaxed text-slate-600 transition-colors hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-700/30"
	                        >
	                          <div class="flex gap-3">
	                            <a href={`?chat=${displayTimestamp}`} data-chat-link data-timestamp={displayTimestamp} class="shrink-0 font-mono text-slate-500 hover:text-purple-700 dark:text-slate-400 dark:hover:text-purple-300" style="min-width: 64px;">{displayTimestamp}</a>
	                            <div class="min-w-0 flex-1">
	                              <span data-chat-speaker class="font-medium text-slate-700 dark:text-slate-300">{entry.speaker}:</span>
	                              <span data-chat-message class="ml-2 whitespace-pre-wrap break-words">{entry.message}</span>
	                            </div>
	                          </div>
	                        </article>
	                      );
	                    })
	                  ) : (
	                    <div class="flex min-h-48 flex-col items-center justify-center text-center">
	                      <p class="text-sm text-slate-500 dark:text-slate-400">No chat logs available</p>
	                    </div>
                  )}
	                </div>
	              </section>

	              {breakoutPanels.map((panel) => (
	                <section data-call-view={panel.breakout.kind} hidden class="call-side-card rounded-lg border border-slate-200 bg-white p-4 shadow-sm transition-shadow hover:shadow-md lg:col-start-2 dark:border-slate-700 dark:bg-slate-800">
	                  <h2 class="mb-3 text-sm font-semibold text-slate-900 dark:text-slate-100">{panel.label} Chat</h2>
	                  <div class="min-h-0 flex-1 space-y-2 overflow-y-auto pr-2">
	                    {panel.chatEntries.length ? (
	                      panel.chatEntries.map((entry) => (
	                        <article
	                          id={`${panel.breakout.kind}-${entry.fragment}`}
	                          data-call-entry
	                          data-kind="chat"
	                          data-breakout={panel.breakout.kind}
	                          data-timestamp={entry.timestamp}
	                          data-seconds={entry.seconds}
	                          tabindex="-1"
	                          class="searchable rounded border border-transparent px-2 py-1 text-xs leading-relaxed text-slate-600 transition-colors hover:bg-slate-50 dark:text-slate-400 dark:hover:bg-slate-700/30"
	                        >
	                          <div class="flex gap-3">
	                            <a href={`?breakout=${panel.breakout.kind}&chat=${entry.timestamp}`} data-chat-link data-timestamp={entry.timestamp} class="shrink-0 font-mono text-slate-500 hover:text-purple-700 dark:text-slate-400 dark:hover:text-purple-300" style="min-width: 64px;">{entry.timestamp}</a>
	                            <div class="min-w-0 flex-1">
	                              <span data-chat-speaker class="font-medium text-slate-700 dark:text-slate-300">{entry.speaker}:</span>
	                              <span data-chat-message class="ml-2 whitespace-pre-wrap break-words">{entry.message}</span>
	                            </div>
	                          </div>
	                        </article>
	                      ))
	                    ) : (
	                      <p class="text-sm italic text-slate-500 dark:text-slate-400">Breakout chat log unavailable.</p>
	                    )}
	                  </div>
	                </section>
	              ))}

                {artifacts.tldr && (
                  <section id="call-summary-panel" class="call-summary-section lg:col-start-1 lg:row-start-2">
                    <details open class="group rounded-lg border border-slate-200 bg-white shadow-sm transition-shadow hover:shadow-md dark:border-slate-700 dark:bg-slate-800">
                      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-lg px-4 py-3 transition-colors hover:bg-slate-50 dark:hover:bg-slate-700/30 [&::-webkit-details-marker]:hidden">
                        <div class="flex min-w-0 flex-wrap items-center gap-x-2 gap-y-1">
                          <h2 class="text-sm font-semibold text-slate-900 dark:text-slate-100">Summary</h2>
                          <span class="text-xs text-slate-500 dark:text-slate-400">
                            {tldrHighlightCount} highlights
                            {summaryDecisionCount ? ` · ${summaryDecisionCount} decisions` : ""}
                            {` · ${tldrActionCount} action items`}
                          </span>
                          <span class="rounded-full border border-slate-200 bg-slate-100 px-2 py-0.5 font-normal text-slate-500 text-xs dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Experimental</span>
                        </div>
                        <ChevronDown class="h-4 w-4 shrink-0 text-slate-400 transition group-open:rotate-180" />
                      </summary>
                      <div class="grid gap-6 border-t border-slate-200 p-6 lg:grid-cols-2 dark:border-slate-700">
                        <div class="space-y-4">
                          {Object.entries(artifacts.tldr.highlights ?? {}).map(([category, highlights]) => (
                            <div>
                              <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100">{category.replaceAll("_", " ")}</h3>
                              <ul class="ml-5 list-outside list-disc space-y-1 text-slate-600 dark:text-slate-400">
                                {highlights.map((item) => {
                                  const timestamp = displaySummaryTimestamp(item.timestamp);
                                  return (
                                    <li class="searchable group cursor-pointer text-sm text-slate-600 dark:text-slate-400" data-kind="summary" data-timestamp={timestamp ?? undefined}>
                                      <span class="rounded px-1 py-0.5 transition-colors group-hover:text-slate-900 dark:group-hover:text-slate-100">{item.highlight}</span>
                                      {timestamp && <a href={`#t=${timestamp}`} data-transcript-link class="ml-1 font-mono text-slate-400 text-xs opacity-0 transition-opacity group-hover:opacity-100 dark:text-slate-500">{timestamp}</a>}
                                    </li>
                                  );
                                })}
                              </ul>
                            </div>
                          ))}
                        </div>
                        <div class="space-y-6">
                          {(artifacts.keyDecisions.length > 0 || fallbackTldrDecisions.length > 0) && (
                            <div class="rounded-lg border border-slate-200 bg-slate-50/50 p-4 dark:border-slate-700 dark:bg-slate-800/50">
                              <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100">Decisions</h3>
                              <ul class="space-y-1">
                                {artifacts.keyDecisions.length > 0 ? (
                                  artifacts.keyDecisions.map((decision) => {
                                    const timestamp = displaySummaryTimestamp(decision.timestamp);
                                    return (
                                      <li class="searchable group cursor-pointer text-sm text-slate-600 before:mr-2 before:text-slate-400 before:content-['→'] dark:text-slate-400 dark:before:text-slate-500" data-kind="summary" data-timestamp={timestamp ?? undefined}>
                                        <span class="rounded px-1 py-0.5 transition-colors group-hover:text-slate-900 dark:group-hover:text-slate-100">
                                          <StructuredDecision decision={decision} />
                                        </span>
                                        {timestamp && <a href={`#t=${timestamp}`} data-transcript-link class="ml-1 font-mono text-slate-400 text-xs opacity-0 transition-opacity group-hover:opacity-100 dark:text-slate-500">{timestamp}</a>}
                                      </li>
                                    );
                                  })
                                ) : (
                                  fallbackTldrDecisions.map((item) => {
                                    const timestamp = displaySummaryTimestamp(item.timestamp);
                                    return (
                                      <li class="searchable group cursor-pointer text-sm text-slate-600 before:mr-2 before:text-slate-400 before:content-['→'] dark:text-slate-400 dark:before:text-slate-500" data-kind="summary" data-timestamp={timestamp ?? undefined}>
                                        <span class="rounded px-1 py-0.5 transition-colors group-hover:text-slate-900 dark:group-hover:text-slate-100">{item.text}</span>
                                        {timestamp && <a href={`#t=${timestamp}`} data-transcript-link class="ml-1 font-mono text-slate-400 text-xs opacity-0 transition-opacity group-hover:opacity-100 dark:text-slate-500">{timestamp}</a>}
                                      </li>
                                    );
                                  })
                                )}
                              </ul>
                            </div>
                          )}
                          {tldrSections.map((section) => (
                            <div>
                              <h3 class="mb-2 text-xs font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100">{section.title}</h3>
                              <ul class="space-y-1">
                                {section.items.map((item) => {
                                  const timestamp = displaySummaryTimestamp(item.timestamp);
                                  return (
                                    <li class="searchable group cursor-pointer text-sm text-slate-600 before:mr-2 before:text-slate-400 before:content-['→'] dark:text-slate-400 dark:before:text-slate-500" data-kind="summary" data-timestamp={timestamp ?? undefined}>
                                      <span class="rounded px-1 py-0.5 transition-colors group-hover:text-slate-900 dark:group-hover:text-slate-100">{item.text}</span>
                                      {timestamp && <a href={`#t=${timestamp}`} data-transcript-link class="ml-1 font-mono text-slate-400 text-xs opacity-0 transition-opacity group-hover:opacity-100 dark:text-slate-500">{timestamp}</a>}
                                    </li>
                                  );
                                })}
                              </ul>
                            </div>
                          ))}
                        </div>
                      </div>
                    </details>
                  </section>
                )}
            </div>
          </div>

          <div id="call-search-dialog" class="fixed inset-0 z-50 hidden items-start justify-center px-2 pt-4 sm:px-4 sm:pt-20" role="dialog" aria-modal="true" aria-labelledby="call-search-dialog-title" aria-hidden="true" hidden>
            <button id="call-search-dialog-backdrop" type="button" class="absolute inset-0 bg-slate-900/50 backdrop-blur-sm" aria-label="Close call search"></button>
            <section class="relative max-h-[90vh] w-full max-w-3xl overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-slate-800">
              <div class="border-b border-slate-200 dark:border-slate-700">
                <div class="flex items-center gap-3 p-4">
                  <Search class="h-5 w-5 shrink-0 text-slate-400" />
                  <input id="call-search-dialog-input" type="search" autocomplete="off" placeholder="Search this call..." class="min-h-11 flex-1 bg-transparent text-base text-slate-900 outline-none placeholder:text-slate-400 dark:text-slate-100 dark:placeholder:text-slate-400" />
                  <button id="call-search-dialog-close" type="button" class="rounded-md p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-600 dark:hover:bg-slate-700 dark:hover:text-slate-200" aria-label="Close search">
                    <X class="h-5 w-5" />
                  </button>
                </div>
                <div class="flex items-center justify-between gap-3 px-4 pb-3 text-xs text-slate-500 dark:text-slate-400">
                  <h2 id="call-search-dialog-title" class="font-medium text-slate-600 dark:text-slate-300">Call search</h2>
                  <span id="call-search-dialog-scope" class="rounded-full border border-slate-200 bg-slate-50 px-2 py-1 dark:border-slate-700 dark:bg-slate-900">Main call</span>
                </div>
              </div>
              <div id="call-search-dialog-results" class="max-h-[60vh] overflow-y-auto py-2 sm:max-h-96">
                <div class="p-8 text-center text-sm text-slate-400 dark:text-slate-500">
                  <div class="mx-auto flex max-w-sm flex-wrap justify-center gap-2 text-xs">
                    <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Summary</span>
                    <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Transcript</span>
                    <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Chat</span>
                  </div>
                </div>
              </div>
              <div id="call-search-dialog-footer" class="hidden border-t border-slate-200 px-4 py-2 text-xs text-slate-500 dark:border-slate-700 dark:text-slate-400"></div>
            </section>
          </div>

	          <script>
		            const setupCallDetailPage = () => {
		            const pageRoot = document.getElementById("call-page-root");
		            if (!pageRoot || pageRoot.dataset.callDetailBound === "true") return;
		            pageRoot.dataset.callDetailBound = "true";
		            const controller = new AbortController();
		            const { signal } = controller;
		            document.addEventListener("astro:before-swap", () => controller.abort(), {
		              once: true,
		            });
		            const searchTriggers = Array.from(document.querySelectorAll<HTMLElement>("[data-open-call-search]"));
		            const theaterToggles = Array.from(document.querySelectorAll<HTMLButtonElement>("[data-theater-toggle]"));
	            const searchDialog = document.getElementById("call-search-dialog");
	            const searchDialogInput = document.getElementById("call-search-dialog-input") as HTMLInputElement | null;
	            const searchDialogResults = document.getElementById("call-search-dialog-results");
	            const searchDialogFooter = document.getElementById("call-search-dialog-footer");
	            const searchDialogScope = document.getElementById("call-search-dialog-scope");
	            const searchDialogClose = document.getElementById("call-search-dialog-close");
	            const searchDialogBackdrop = document.getElementById("call-search-dialog-backdrop");
	            const items = Array.from(document.querySelectorAll<HTMLElement>(".searchable"));
	            const callEntries = Array.from(document.querySelectorAll<HTMLElement>("[data-call-entry]"));
	            const callViews = Array.from(document.querySelectorAll<HTMLElement>("[data-call-view]"));
	            const breakoutFilters = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-breakout-filter]"));
	            const breakoutSelectors = Array.from(document.querySelectorAll<HTMLElement>("[data-breakout-selector]"));
	            let callSearchResults: CallSearchEntry[] = [];
	            let selectedCallSearchIndex = 0;

	            type CallSearchEntry = {
	              index: number;
	              item: HTMLElement;
	              kind: string;
	              label: string;
	              timestamp: string | null;
	              text: string;
	              view: string;
	            };

	            const activeBreakoutKind = () => {
	              const params = new URLSearchParams(window.location.search);
	              const requested = params.get("breakout");
	              return breakoutFilters.some((filter) => filter.dataset.breakoutFilter === requested) ? requested ?? "main" : "main";
	            };

	            const applyBreakoutView = () => {
	              const active = activeBreakoutKind();
	              for (const view of callViews) {
	                view.hidden = view.dataset.callView !== active;
	              }
	              for (const filter of breakoutFilters) {
	                const isActive = filter.dataset.breakoutFilter === active;
	                filter.setAttribute("aria-current", isActive ? "page" : "false");
	                filter.dataset.active = String(isActive);
	              }
	              const activeFilter = breakoutFilters.find((filter) => filter.dataset.breakoutFilter === active);
	              for (const selector of breakoutSelectors) {
	                const label = selector.querySelector<HTMLElement>("[data-breakout-current-label]");
	                if (label) label.textContent = activeFilter?.textContent?.trim() || "Main call";
	              }
	              if (searchDialogScope) {
	                searchDialogScope.textContent = activeFilter?.textContent?.trim() || "Main call";
	              }
	            };

	            const secondsToTimestamp = (seconds: number) => {
	              const safeSeconds = Math.max(0, Math.floor(seconds));
	              const hours = Math.floor(safeSeconds / 3600);
	              const minutes = Math.floor((safeSeconds % 3600) / 60);
	              const remainingSeconds = safeSeconds % 60;
	              return [hours, minutes, remainingSeconds].map((part) => String(part).padStart(2, "0")).join(":");
	            };

	            const normalizeTimestamp = (value: string | null) => {
	              if (!value) return null;
	              const decoded = decodeURIComponent(value);
	              if (/^\d+$/.test(decoded)) return secondsToTimestamp(Number.parseInt(decoded, 10));
	              const match = decoded.match(/\d{2}:\d{2}:\d{2}/);
	              return match?.[0] ?? null;
	            };

	            const timestampToSeconds = (timestamp: string | null) => {
	              const normalized = normalizeTimestamp(timestamp);
	              if (!normalized) return null;
	              const [hours, minutes, seconds] = normalized.split(":").map((part) => Number.parseInt(part, 10));
	              if ([hours, minutes, seconds].some((part) => !Number.isFinite(part))) return null;
	              return hours * 3600 + minutes * 60 + seconds;
	            };

	            const activeVideoFrame = () => {
	              const activeView = activeBreakoutKind();
	              const panel = callViews.find((view) => view.dataset.callView === activeView && !view.hidden && view.hasAttribute("data-video-panel"));
	              return panel?.querySelector<HTMLIFrameElement>("iframe") ?? null;
	            };

	            const sendVideoCommand = (func: string, args: unknown[] = []) => {
	              const frame = activeVideoFrame();
	              frame?.contentWindow?.postMessage(JSON.stringify({ event: "command", func, args }), "*");
	            };

	            const seekVideoToTimestamp = (timestamp: string | null) => {
	              const seconds = timestampToSeconds(timestamp);
	              if (seconds === null) return;
	              sendVideoCommand("seekTo", [seconds, true]);
	              sendVideoCommand("playVideo");
	            };

	            const clearActiveEntry = () => {
	              for (const entry of callEntries) {
	                entry.dataset.active = "false";
	                entry.removeAttribute("aria-current");
	              }
	            };

	            const activateEntry = (kind: "transcript" | "chat", timestamp: string | null) => {
	              clearActiveEntry();
	              if (!timestamp) return;
	              for (const entry of callEntries) entry.dataset.current = "false";
	              const activeBreakout = activeBreakoutKind();
	              const target = callEntries.find((entry) => {
	                const entryBreakout = entry.dataset.breakout ?? "main";
	                return entry.dataset.kind === kind && entry.dataset.timestamp === timestamp && entryBreakout === activeBreakout;
	              });
	              if (!target) return;
	              target.hidden = false;
	              target.dataset.active = "true";
	              target.setAttribute("aria-current", "true");
	              target.scrollIntoView({ block: "center" });
	              target.focus({ preventScroll: true });
	            };

	            const applyDeepLink = () => {
	              applyBreakoutView();
	              const params = new URLSearchParams(window.location.search);
	              const chatTimestamp = normalizeTimestamp(params.get("chat"));
	              if (chatTimestamp) {
	                activateEntry("chat", chatTimestamp);
	                return;
	              }

	              const hash = window.location.hash;
	              const transcriptTimestamp = hash.startsWith("#t=")
	                ? normalizeTimestamp(hash.slice(3))
	                : normalizeTimestamp(hash);
	              activateEntry("transcript", transcriptTimestamp);
	            };

	            const escapeHtml = (value: string) =>
	              value.replace(/[&<>"']/g, (character) => {
	                const entities: Record<string, string> = {
	                  "&": "&amp;",
	                  "<": "&lt;",
	                  ">": "&gt;",
	                  '"': "&quot;",
	                  "'": "&#39;",
	                };
	                return entities[character] ?? character;
	              });

	            const entryLabel = (kind: string) => {
	              if (kind === "transcript") return "Transcript";
	              if (kind === "chat") return "Chat";
	              return "Summary";
	            };

		            const cleanText = (node: Element | null) =>
		              node?.textContent?.replace(/\s+/g, " ").trim() ?? "";

		            const readableSearchText = (item: HTMLElement, kind: string, timestamp: string | null) => {
		              if (kind === "chat") {
		                const speaker = cleanText(item.querySelector("[data-chat-speaker]"));
		                const message = cleanText(item.querySelector("[data-chat-message]"));
		                return [speaker, message].filter(Boolean).join(": ");
	              }
	              if (kind === "summary") {
	                const rawText = cleanText(item);
	                return timestamp ? rawText.replace(timestamp, "").trim() : rawText;
	              }
	              const rawText = cleanText(item);
	              return timestamp ? rawText.replace(timestamp, "").trim() : rawText;
	            };

	            const searchEntries: CallSearchEntry[] = items.map((item, index) => {
	              const view = item.closest<HTMLElement>("[data-call-view]")?.dataset.callView ?? "main";
	              const kind = item.dataset.kind ?? "summary";
	              const timestamp = item.dataset.timestamp ?? item.querySelector("a")?.textContent?.trim() ?? null;
	              return {
	                index,
	                item,
	                kind,
	                label: entryLabel(kind),
	                timestamp,
	                text: readableSearchText(item, kind, timestamp),
	                view,
	              };
	            });

	            const isSearchHotkey = (event: KeyboardEvent) =>
	              (event.metaKey || event.ctrlKey) && !event.altKey && !event.shiftKey && event.key.toLowerCase() === "k";

	            const closeSearchDialog = () => {
	              if (!searchDialog) return;
	              searchDialog.hidden = true;
	              searchDialog.classList.add("hidden");
	              searchDialog.classList.remove("flex");
	              searchDialog.setAttribute("aria-hidden", "true");
	              document.body.style.overflow = "";
	            };

	            const resultExcerpt = (entry: CallSearchEntry, query: string) => {
	              if (!query.trim()) return entry.text.slice(0, 220);
	              const lowerText = entry.text.toLowerCase();
	              const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
	              const firstMatch = terms
	                .map((term) => lowerText.indexOf(term))
	                .filter((index) => index >= 0)
	                .sort((a, b) => a - b)[0] ?? 0;
	              const start = Math.max(0, firstMatch - 80);
	              const end = Math.min(entry.text.length, firstMatch + 180);
	              const prefix = start > 0 ? "..." : "";
	              const suffix = end < entry.text.length ? "..." : "";
	              return `${prefix}${entry.text.slice(start, end)}${suffix}`;
	            };

	            const renderSearchDialogResults = () => {
	              if (!searchDialogResults || !searchDialogInput || !searchDialogFooter) return;
	              const query = searchDialogInput.value.trim();
	              const activeView = activeBreakoutKind();
	              if (!query) {
	                callSearchResults = [];
	                selectedCallSearchIndex = 0;
	                searchDialogResults.innerHTML = `
	                  <div class="p-8 text-center text-sm text-slate-400 dark:text-slate-500">
	                    <div class="mx-auto flex max-w-sm flex-wrap justify-center gap-2 text-xs">
	                      <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Summary</span>
	                      <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Transcript</span>
	                      <span class="rounded-lg border border-slate-200 bg-slate-50 px-2.5 py-1.5 text-slate-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300">Chat</span>
	                    </div>
	                  </div>
	                `;
	                searchDialogFooter.hidden = true;
	                searchDialogFooter.classList.add("hidden");
	                return;
	              }

	              const terms = query.toLowerCase().split(/\s+/).filter(Boolean);
	              callSearchResults = searchEntries
	                .filter((entry) => entry.view === activeView)
	                .filter((entry) => {
	                  const text = entry.text.toLowerCase();
	                  return terms.every((term) => text.includes(term));
	                })
	                .slice(0, 80);
	              selectedCallSearchIndex = Math.min(selectedCallSearchIndex, Math.max(callSearchResults.length - 1, 0));

	              if (callSearchResults.length === 0) {
	                searchDialogResults.innerHTML = '<div class="p-8 text-center text-sm text-slate-500 dark:text-slate-400">No results found</div>';
	                searchDialogFooter.hidden = true;
	                searchDialogFooter.classList.add("hidden");
	                return;
	              }

	              searchDialogResults.innerHTML = callSearchResults
	                .map((entry, index) => `
	                  <button
	                    type="button"
	                    data-call-search-result="${index}"
	                    data-active="${index === selectedCallSearchIndex}"
	                    class="block w-full px-4 py-3 text-left transition hover:bg-slate-50 data-[active=true]:bg-slate-50 dark:hover:bg-slate-700/30 dark:data-[active=true]:bg-slate-700/30"
	                  >
	                    <div class="flex items-start gap-3">
	                      <span class="mt-0.5 shrink-0 rounded bg-purple-50 px-2 py-1 font-mono text-purple-600 text-xs dark:bg-purple-900/30 dark:text-purple-300">${escapeHtml(entry.timestamp ?? entry.label)}</span>
	                      <span class="min-w-0 flex-1">
	                        <span class="mb-1 flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
	                          <span class="font-medium text-slate-600 dark:text-slate-300">${entry.label}</span>
	                          ${entry.view === "main" ? "" : `<span>${escapeHtml(entry.view.toUpperCase())}</span>`}
	                        </span>
	                        <span class="line-clamp-2 text-sm leading-relaxed text-slate-800 dark:text-slate-100">${escapeHtml(resultExcerpt(entry, query))}</span>
	                      </span>
	                    </div>
	                  </button>
	                `)
	                .join("");
	              searchDialogFooter.hidden = false;
	              searchDialogFooter.classList.remove("hidden");
	              searchDialogFooter.textContent = `${callSearchResults.length} result${callSearchResults.length === 1 ? "" : "s"}`;
	            };

	            const openSearchDialog = () => {
	              if (!searchDialog || !searchDialogInput) return;
	              applyBreakoutView();
	              searchDialog.hidden = false;
	              searchDialog.classList.remove("hidden");
	              searchDialog.classList.add("flex");
	              searchDialog.setAttribute("aria-hidden", "false");
	              document.body.style.overflow = "hidden";
	              searchDialogInput.value = "";
	              renderSearchDialogResults();
	              searchDialogInput.focus();
	              searchDialogInput.select();
	            };

	            const activateSearchResult = (entry: CallSearchEntry) => {
	              if (entry.kind === "chat" && entry.timestamp) {
	                const nextUrl = new URL(window.location.href);
	                if (entry.view === "main") nextUrl.searchParams.delete("breakout");
	                else nextUrl.searchParams.set("breakout", entry.view);
	                nextUrl.searchParams.set("chat", entry.timestamp);
	                nextUrl.hash = "";
	                history.pushState(null, "", nextUrl);
	                applyDeepLink();
	                closeSearchDialog();
	                return;
	              }

	              if (entry.timestamp) {
	                const nextUrl = new URL(window.location.href);
	                nextUrl.searchParams.delete("chat");
	                if (entry.view === "main") nextUrl.searchParams.delete("breakout");
	                else nextUrl.searchParams.set("breakout", entry.view);
	                nextUrl.hash = `t=${entry.timestamp}`;
	                history.pushState(null, "", nextUrl);
	                applyDeepLink();
	                closeSearchDialog();
	                return;
	              }

	              entry.item.hidden = false;
	              entry.item.scrollIntoView({ block: "center" });
	              closeSearchDialog();
	            };

	            document.addEventListener("click", (event) => {
	              if (!(event.target instanceof Element)) return;
	              const link = event.target.closest<HTMLAnchorElement>("[data-transcript-link]");
	              if (!link) return;
	              const timestamp = normalizeTimestamp(link.hash.startsWith("#t=") ? link.hash.slice(3) : link.textContent);
	              seekVideoToTimestamp(timestamp);
	            }, { signal });

	            document.querySelectorAll<HTMLAnchorElement>("[data-chat-link]").forEach((link) => {
	              link.addEventListener("click", (event) => {
	                event.preventDefault();
	                const timestamp = link.dataset.timestamp;
	                const nextUrl = new URL(window.location.href);
	                if (timestamp) nextUrl.searchParams.set("chat", timestamp);
	                nextUrl.hash = "";
	                history.pushState(null, "", nextUrl);
	                applyDeepLink();
	              });
	            });

		            const updateTheaterControls = () => {
		              const isTheater = pageRoot?.dataset.theater === "true";
		              for (const toggle of theaterToggles) {
		                toggle.querySelector("[data-theater-expand]")?.classList.toggle("hidden", isTheater);
		                toggle.querySelector("[data-theater-collapse]")?.classList.toggle("hidden", !isTheater);
		                const label = toggle.querySelector("[data-theater-label]");
		                if (label) label.textContent = isTheater ? "Exit Theater" : "Theater Mode";
		              }
		            };

	            for (const trigger of searchTriggers) {
		              trigger.addEventListener("click", (event) => {
		                event.preventDefault();
		                openSearchDialog();
		              });
		            }
		            for (const toggle of theaterToggles) {
		              toggle.addEventListener("click", () => {
		                if (!pageRoot) return;
		                pageRoot.dataset.theater = pageRoot.dataset.theater === "true" ? "false" : "true";
		                updateTheaterControls();
		              });
	            }
	            const closeBreakoutMenus = () => {
	              for (const selector of breakoutSelectors) {
	                selector.dataset.open = "false";
	                selector.querySelector<HTMLButtonElement>("[data-breakout-selector-button]")?.setAttribute("aria-expanded", "false");
	                selector.querySelector<HTMLElement>("[data-breakout-selector-menu]")?.classList.add("hidden");
	                selector.querySelector<HTMLElement>("[data-breakout-selector-chevron]")?.classList.remove("rotate-180");
	              }
	            };
	            for (const selector of breakoutSelectors) {
	              const button = selector.querySelector<HTMLButtonElement>("[data-breakout-selector-button]");
	              const menu = selector.querySelector<HTMLElement>("[data-breakout-selector-menu]");
	              const chevron = selector.querySelector<HTMLElement>("[data-breakout-selector-chevron]");
	              button?.addEventListener("click", (event) => {
	                event.preventDefault();
	                event.stopPropagation();
	                const open = selector.dataset.open !== "true";
	                closeBreakoutMenus();
	                selector.dataset.open = String(open);
	                button.setAttribute("aria-expanded", String(open));
	                menu?.classList.toggle("hidden", !open);
	                chevron?.classList.toggle("rotate-180", open);
	              });
	            }
	            document.addEventListener("click", (event) => {
	              if (event.target instanceof Element && event.target.closest("[data-breakout-selector]")) return;
	              closeBreakoutMenus();
	            }, { signal });
	            searchDialogInput?.addEventListener("input", renderSearchDialogResults);
	            searchDialogClose?.addEventListener("click", closeSearchDialog);
	            searchDialogBackdrop?.addEventListener("click", closeSearchDialog);
	            searchDialogResults?.addEventListener("click", (event) => {
	              const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-call-search-result]");
	              if (!button) return;
	              const index = Number.parseInt(button.dataset.callSearchResult ?? "", 10);
	              const result = callSearchResults[index];
	              if (result) activateSearchResult(result);
	            });
	            document.addEventListener("keydown", (event) => {
	              if (isSearchHotkey(event)) {
	                event.preventDefault();
	                openSearchDialog();
	                return;
	              }

	              if (!searchDialog || searchDialog.hidden) return;
	              if (event.key === "Escape") {
	                event.preventDefault();
	                closeSearchDialog();
	                return;
	              }
	              if (event.key === "ArrowDown") {
	                event.preventDefault();
	                selectedCallSearchIndex = Math.min(selectedCallSearchIndex + 1, Math.max(callSearchResults.length - 1, 0));
	                renderSearchDialogResults();
	                return;
	              }
	              if (event.key === "ArrowUp") {
	                event.preventDefault();
	                selectedCallSearchIndex = Math.max(selectedCallSearchIndex - 1, 0);
	                renderSearchDialogResults();
	                return;
	              }
	              if (event.key === "Enter") {
	                const result = callSearchResults[selectedCallSearchIndex];
	                if (result) {
	                  event.preventDefault();
	                  activateSearchResult(result);
	                }
	              }
	            }, { signal });

	            breakoutFilters.forEach((filter) => {
	              filter.addEventListener("click", (event) => {
	                event.preventDefault();
	                const nextUrl = new URL(window.location.href);
	                const breakout = filter.dataset.breakoutFilter;
	                nextUrl.searchParams.delete("chat");
	                if (!breakout || breakout === "main") nextUrl.searchParams.delete("breakout");
	                else nextUrl.searchParams.set("breakout", breakout);
	                nextUrl.hash = "";
	                history.pushState(null, "", nextUrl);
	                for (const item of items) item.hidden = false;
	                applyDeepLink();
	                renderSearchDialogResults();
	                closeBreakoutMenus();
	              });
	            });

		            window.addEventListener("hashchange", applyDeepLink, { signal });
		            window.addEventListener("popstate", applyDeepLink, { signal });
		            updateTheaterControls();
		            applyDeepLink();
		          };
		          setupCallDetailPage();
		          document.addEventListener("astro:page-load", setupCallDetailPage);
		          </script>
		          <style is:global>
