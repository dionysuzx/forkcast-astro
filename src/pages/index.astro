---
import { CalendarDays, ChevronRight, Globe, ShieldCheck } from "@lucide/astro";
import StructuredDecision from "@/components/calls/StructuredDecision.astro";
import UpgradeCard from "@/components/upgrades/UpgradeCard.astro";
import { getLatestMeetingDecisionSet } from "@/domain/calls/artifacts";
import {
	callTypeNames,
	getCallTitle,
	isOneOffCall,
	protocolCalls,
	recentProtocolCalls,
} from "@/domain/calls/call";
import {
	callTypeBadgeClass,
	stageLabel,
	upgradeBadgeClass,
} from "@/domain/display";
import {
	getInclusionStage,
	getLaymanTitle,
	getProposalCode,
	recentlyUpdatedProposals,
} from "@/domain/proposals/proposal";
import {
	activeNetworkUpgrades,
	getForkDisplayName,
	type NetworkUpgrade,
	networkUpgrades,
} from "@/domain/upgrades/upgrade";
import BaseLayout from "@/layouts/BaseLayout.astro";

const previous = [...activeNetworkUpgrades]
	.reverse()
	.find((upgrade) => upgrade.status === "Live");
const current = activeNetworkUpgrades.find(
	(upgrade) => upgrade.status === "Upcoming",
);
const future = activeNetworkUpgrades.find(
	(upgrade) => upgrade.status === "Planning" || upgrade.status === "Research",
);
const quickLinks = [previous, current, future].filter(
	(upgrade): upgrade is NetworkUpgrade => Boolean(upgrade),
);
const featuredProposals = recentlyUpdatedProposals(4);
const recentCalls = recentProtocolCalls(5);
const recentDecisionSet = getLatestMeetingDecisionSet(protocolCalls);
const neutralStageBadgeClass =
	"bg-slate-100 text-slate-700 dark:bg-slate-700 dark:text-slate-300";
const forkBadgeClass = (forkName: string): string => {
	const normalized = forkName.toLowerCase();
	const upgrade = networkUpgrades.find(
		(candidate) =>
			candidate.id === normalized ||
			candidate.name.toLowerCase().includes(normalized),
	);
	return upgrade
		? upgradeBadgeClass(upgrade.status)
		: "bg-slate-50/50 text-slate-600 border border-slate-200 dark:bg-slate-900/30 dark:text-slate-400 dark:border-slate-700";
};
---

<BaseLayout>
  <div class="min-h-screen bg-slate-50 p-6 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <div class="mx-auto max-w-4xl">
      <div class="mb-10 text-center">
        <h1 class="mb-2 text-2xl font-light tracking-tight text-slate-900 sm:text-3xl dark:text-slate-100">
          Ethereum Upgrade Tracker
        </h1>
        <p class="mx-auto max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-400">
          See what's on the horizon and how it impacts you.
        </p>
      </div>

      <section>
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-medium text-slate-900 dark:text-slate-100">Network Upgrades</h2>
          <a href="/upgrades" data-astro-prefetch class="text-sm text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200">
            View all upgrades →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
          {
            quickLinks.map((upgrade) => (
              <UpgradeCard upgrade={upgrade} />
            ))
          }
        </div>
      </section>

      <section class="mt-12">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-medium text-slate-900 dark:text-slate-100">Recently Updated EIPs</h2>
          <a href="/eips" data-astro-prefetch class="text-sm text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200">
            Browse all EIPs →
          </a>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
          {
            featuredProposals.map((proposal) => {
              const latestFork = proposal.forkRelationships.at(-1);
              const stage = latestFork ? getInclusionStage(proposal, latestFork.forkName) : null;
              return (
                <a
                  href={`/eips/${proposal.id}`}
                  data-astro-prefetch
                  class="group flex items-start justify-between gap-3 rounded-lg border border-slate-200 bg-white p-4 transition hover:border-purple-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:hover:border-purple-600 dark:hover:shadow-slate-700/20"
                >
                  <div class="min-w-0 flex-1">
                    <div class="mb-2 flex flex-wrap items-center gap-2">
                      <span class="font-mono text-sm font-medium text-purple-600 dark:text-purple-400">
                        {getProposalCode(proposal)}
                      </span>
                      {stage && stage !== "Unknown" && (
                        <span class={`rounded px-2 py-0.5 text-xs font-medium ${neutralStageBadgeClass}`}>{stageLabel(stage)}</span>
                      )}
                      {latestFork && (
                        <span class={`rounded px-2 py-0.5 text-xs font-medium ${forkBadgeClass(latestFork.forkName)}`}>
                          {getForkDisplayName(latestFork.forkName)}
                        </span>
                      )}
                    </div>
                    <h3 class="mb-1 text-sm font-medium leading-snug text-slate-900 dark:text-slate-100">
                      {getLaymanTitle(proposal)}
                    </h3>
                    <p class="line-clamp-2 text-xs text-slate-600 dark:text-slate-400">
                      {proposal.laymanDescription || proposal.description}
                    </p>
                  </div>
                  <ChevronRight class="mt-0.5 h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-purple-500" />
                </a>
              );
            })
          }
        </div>
      </section>

      <section class="mt-12">
        <div class="mb-4 flex items-center justify-between">
          <h2 class="text-xl font-medium text-slate-900 dark:text-slate-100">Recent Protocol Calls</h2>
          <a href="/calls" data-astro-prefetch class="text-sm text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200">
            View all calls →
          </a>
        </div>
        <div class="space-y-2">
          {
            recentCalls.map((call) => (
              <a
                href={`/calls/${call.path}`}
                data-astro-prefetch
                class="group flex items-center justify-between gap-3 rounded-lg border border-slate-200 bg-white p-4 transition hover:border-purple-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:hover:border-purple-600 dark:hover:shadow-slate-700/20"
              >
                <div class="flex min-w-0 items-center gap-3">
                  <span class={`inline-block min-w-[3.5rem] flex-shrink-0 rounded px-2 py-0.5 text-center text-xs font-medium ${callTypeBadgeClass(call.type)}`}>
                    {isOneOffCall(call.type) ? "1-OFF" : call.type.toUpperCase()}
                  </span>
                  <span class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">{getCallTitle(call)}</span>
                </div>
                <div class="flex flex-shrink-0 items-center gap-3">
                  <span class="text-sm text-slate-600 dark:text-slate-400">{call.date}</span>
                  <ChevronRight class="h-5 w-5 text-slate-400 group-hover:text-purple-500" />
                </div>
              </a>
            ))
          }
        </div>
      </section>

      {
        recentDecisionSet && (
          <section class="mt-12">
            <div class="mb-4 flex items-center justify-between">
              <h2 class="text-xl font-medium text-slate-900 dark:text-slate-100">Recent Decisions</h2>
              <a href="/decisions" data-astro-prefetch class="text-sm text-slate-600 transition-colors hover:text-slate-900 dark:text-slate-400 dark:hover:text-slate-200">
                View all decisions →
              </a>
            </div>
            <div class="overflow-hidden rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
                <a
                  href={`/calls/${recentDecisionSet.call.path}`}
                  data-astro-prefetch
                  class="group flex items-center justify-between gap-3 border-b border-slate-100 px-4 py-3 transition-colors hover:bg-slate-50 dark:border-slate-700 dark:hover:bg-slate-700/30"
              >
                <div class="flex min-w-0 items-center gap-3">
                  <span class={`inline-block min-w-[3.5rem] flex-shrink-0 rounded px-2 py-0.5 text-center text-xs font-medium ${callTypeBadgeClass(recentDecisionSet.call.type)}`}>
                    {recentDecisionSet.call.type.toUpperCase()}
                  </span>
                  <span class="truncate text-sm font-medium text-slate-900 dark:text-slate-100">
                    {callTypeNames[recentDecisionSet.call.type as keyof typeof callTypeNames] ?? recentDecisionSet.call.type} #{recentDecisionSet.call.number}
                  </span>
                </div>
                <div class="flex shrink-0 items-center gap-3">
                  <span class="hidden text-sm text-slate-600 sm:inline dark:text-slate-400">{recentDecisionSet.call.date}</span>
                  <ChevronRight class="h-5 w-5 text-slate-400 group-hover:text-purple-500" />
                </div>
              </a>
              <ul class="list-none space-y-1.5 px-4 py-3">
                {recentDecisionSet.decisions.map((decision) => (
                  <li class="group text-sm text-slate-600 before:mr-2 before:text-slate-400 before:content-['→'] dark:text-slate-400 dark:before:text-slate-500">
                    <span class="rounded px-1 py-0.5 transition-colors group-hover:text-slate-900 dark:group-hover:text-slate-100">
                      <StructuredDecision decision={decision} />
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      <section class="mt-12">
        <h2 class="mb-4 text-xl font-medium text-slate-900 dark:text-slate-100">Planning Tools</h2>
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          <a href="/schedule" data-astro-prefetch class="group flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-4 transition hover:border-purple-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:hover:border-purple-600">
            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-blue-100 text-blue-600 dark:bg-blue-900/40 dark:text-blue-400">
              <CalendarDays class="h-5 w-5" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="mb-1 text-sm font-medium text-slate-900 dark:text-slate-100">Schedule</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400">Plan fork timelines with adjustable milestones</p>
            </div>
            <ChevronRight class="mt-0.5 h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-purple-500" />
          </a>
          <a href="/devnets" data-astro-prefetch class="group flex items-start gap-3 rounded-lg border border-slate-200 bg-white p-4 transition hover:border-purple-300 hover:shadow-md dark:border-slate-700 dark:bg-slate-800 dark:hover:border-purple-600">
            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-emerald-100 text-emerald-600 dark:bg-emerald-900/40 dark:text-emerald-400">
              <ShieldCheck class="h-5 w-5" />
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="mb-1 text-sm font-medium text-slate-900 dark:text-slate-100">Devnets</h3>
              <p class="text-xs text-slate-600 dark:text-slate-400">Active devnet series and combined inclusion status</p>
            </div>
            <ChevronRight class="mt-0.5 h-5 w-5 flex-shrink-0 text-slate-400 group-hover:text-purple-500" />
          </a>
        </div>
      </section>

      <footer class="mt-16 text-center text-sm text-slate-500 dark:text-slate-400">
        <div class="mb-6">
          <a href="https://ps.ethereum.foundation" target="_blank" rel="noopener noreferrer" class="mx-auto mb-3 flex h-16 w-16 items-center justify-center">
            <img src="/blobby-gradient-red.svg" alt="Ethereum Foundation Protocol Support team logo" class="h-16 w-16 transition-all duration-500 hover:invert dark:invert dark:hover:invert-0" />
          </a>
          <p class="text-sm italic text-slate-500 dark:text-slate-400">Brought to you by</p>
          <a href="https://ps.ethereum.foundation" target="_blank" rel="noopener noreferrer" class="text-lg font-light text-slate-700 transition-colors duration-200 hover:text-slate-900 dark:text-slate-300 dark:hover:text-slate-100">
            EF Protocol Support
          </a>
        </div>
        <div class="mt-4 flex items-center justify-center gap-4">
          <a href="https://ps.ethereum.foundation" target="_blank" rel="noopener noreferrer" aria-label="EF Protocol Support website" class="text-slate-500 transition-colors hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">
            <Globe class="h-5 w-5" />
          </a>
          <a href="https://github.com/ethereum/forkcast" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="text-slate-500 transition-colors hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.372 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.502 11.502 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12 24 5.373 18.627 0 12 0Z" />
            </svg>
          </a>
          <a href="https://x.com/EFProtocol" target="_blank" rel="noopener noreferrer" aria-label="X" class="text-slate-500 transition-colors hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817-5.966 6.817H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231 5.451-6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77Z" />
            </svg>
          </a>
        </div>
      </footer>
    </div>
  </div>
</BaseLayout>
