---
import { ExternalLink, Info, Link as LinkIcon } from "@lucide/astro";
import { GLAMSTERDAM_TIMELINE_PHASES } from "@/constants/timeline-phases";
import { layerBadgeClass, stageBadgeClass, stageLabel } from "@/domain/display";
import {
	getInclusionStage,
	getLaymanTitle,
	getProposalCode,
	getProposalLayer,
	isHeadliner,
	proposalsForFork,
} from "@/domain/proposals/proposal";
import {
	activeNetworkUpgrades,
	getForkDisplayName,
	getUpgradeById,
} from "@/domain/upgrades/upgrade";
import BaseLayout from "@/layouts/BaseLayout.astro";

export const getStaticPaths = () =>
	activeNetworkUpgrades.map((upgrade) => ({
		params: { id: upgrade.id },
		props: { id: upgrade.id },
	}));

const { id } = Astro.props;
const upgrade = getUpgradeById(id);
const forkKey =
	upgrade?.id === "hegota"
		? "Hegota"
		: upgrade?.id === "glamsterdam"
			? "Glamsterdam"
			: upgrade?.name.replace(" Upgrade", "");
const forkProposals = forkKey ? proposalsForFork(forkKey) : [];
const stageOrder = new Map(
	[
		"Scheduled for Inclusion",
		"Considered for Inclusion",
		"Proposed for Inclusion",
		"Declined for Inclusion",
		"Withdrawn",
		"Included",
		"Unknown",
	].map((stage, index) => [stage, index]),
);
const orderedForkProposals = [...forkProposals].sort((a, b) => {
	const aStage = getInclusionStage(a, forkKey);
	const bStage = getInclusionStage(b, forkKey);
	const aHeadliner = isHeadliner(a, forkKey);
	const bHeadliner = isHeadliner(b, forkKey);
	if (aStage === bStage && aHeadliner !== bHeadliner) {
		return aHeadliner ? -1 : 1;
	}
	return (
		(stageOrder.get(aStage) ?? 99) - (stageOrder.get(bStage) ?? 99) ||
		a.id - b.id
	);
});
const timelineUpgrades = activeNetworkUpgrades;
const timelineMarkerPercent = (() => {
	const firstUpcomingIndex = timelineUpgrades.findIndex(
		(item) => item.status === "Upcoming",
	);
	const lastLiveIndex = timelineUpgrades.reduce(
		(lastIndex, item, index) => (item.status === "Live" ? index : lastIndex),
		-1,
	);
	if (
		firstUpcomingIndex <= 0 ||
		lastLiveIndex < 0 ||
		timelineUpgrades.length <= 1
	) {
		return 50;
	}
	const livePosition = ((lastLiveIndex + 0.5) / timelineUpgrades.length) * 100;
	const upcomingPosition =
		((firstUpcomingIndex + 0.5) / timelineUpgrades.length) * 100;
	return (livePosition + upcomingPosition) / 2;
})();
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const glamsterdamTabItems = [
	["/upgrade/glamsterdam", "Overview"],
	["/upgrade/glamsterdam/stakeholders", "Stakeholders"],
	["/upgrade/glamsterdam/devnet-inclusion", "Devnet Inclusion"],
	["/upgrade/glamsterdam/client-priority", "Client Priority"],
	["/upgrade/glamsterdam/test-complexity", "Test Complexity"],
] as const;
const stageCounts = [
	"Proposed for Inclusion",
	"Considered for Inclusion",
	"Scheduled for Inclusion",
	"Declined for Inclusion",
].map((stage) => ({
	stage,
	count: orderedForkProposals.filter(
		(proposal) => getInclusionStage(proposal, forkKey) === stage,
	).length,
}));
const sidebarProposalGroups = [...stageOrder.keys()]
	.map((stage) => ({
		stage,
		proposals: orderedForkProposals.filter(
			(proposal) => getInclusionStage(proposal, forkKey) === stage,
		),
	}))
	.filter((group) => group.proposals.length > 0);
const glamsterdamActivePhaseIndex = GLAMSTERDAM_TIMELINE_PHASES.findIndex(
	(phase) => phase.status === "in-progress",
);
const glamsterdamHighlightPhaseIndex =
	glamsterdamActivePhaseIndex >= 0
		? glamsterdamActivePhaseIndex
		: GLAMSTERDAM_TIMELINE_PHASES.length - 1;
const phaseStatusClass = {
	completed:
		"border-emerald-200 bg-emerald-100 text-emerald-800 dark:border-emerald-700 dark:bg-emerald-900/20 dark:text-emerald-300",
	"in-progress":
		"border-purple-200 bg-purple-100 text-purple-800 dark:border-purple-700 dark:bg-purple-900/20 dark:text-purple-300",
	upcoming:
		"border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-300",
} as const;
const phaseStatusIcon = {
	completed: "✓",
	"in-progress": "→",
	upcoming: "•",
} as const;
const upgradeStatusBadgeClass = (status: string): string => {
	switch (status) {
		case "Live":
			return "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-300";
		case "Upcoming":
			return "bg-blue-100 text-blue-800 dark:bg-blue-900/20 dark:text-blue-300";
		case "Planning":
			return "bg-purple-100 text-purple-800 dark:bg-purple-900/20 dark:text-purple-300";
		case "Research":
			return "bg-orange-100 text-orange-800 dark:bg-orange-900/20 dark:text-orange-300";
		default:
			return "bg-slate-200 text-slate-700 dark:bg-slate-700 dark:text-slate-300";
	}
};
const overviewStageBadgeClass = (stage: string): string => {
	switch (stage) {
		case "Proposed for Inclusion":
			return "bg-blue-50 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300";
		case "Considered for Inclusion":
			return "bg-amber-50 text-amber-700 dark:bg-amber-900/20 dark:text-amber-300";
		case "Scheduled for Inclusion":
			return "bg-green-50 text-green-700 dark:bg-green-900/20 dark:text-green-300";
		case "Declined for Inclusion":
			return "bg-red-50 text-red-800 dark:bg-red-900/20 dark:text-red-300";
		case "Included":
			return "bg-emerald-50 text-emerald-800 dark:bg-emerald-900/20 dark:text-emerald-300";
		default:
			return "bg-slate-100 text-slate-600 dark:bg-slate-700 dark:text-slate-300";
	}
};
---

{
  upgrade ? (
    <BaseLayout title={`${upgrade.name} - Forkcast`} description={upgrade.description}>
      <div class="min-h-screen bg-slate-50 p-6 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
        <div class="mx-auto max-w-4xl">
          <header class="mb-8">
            <a href="/upgrades" data-astro-prefetch class="mb-6 inline-block text-sm font-medium text-slate-600 transition-colors hover:text-slate-800 dark:text-slate-300 dark:hover:text-slate-100">
              ← All Network Upgrades
            </a>

            <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between">
              <div class="flex-1">
                <div class="mb-3 flex items-center justify-between gap-3 lg:justify-start">
                  <h1 class="text-3xl font-light tracking-tight text-slate-900 dark:text-slate-100">
                    <span class="sm:hidden">{upgrade.name.replace(" Upgrade", "")}</span>
                    <span class="hidden sm:inline">{upgrade.name}</span>
                  </h1>
                  <span class={`rounded px-3 py-1 text-xs font-medium lg:hidden ${upgradeStatusBadgeClass(upgrade.status)}`}>{upgrade.status}</span>
                </div>
                <p class="mb-2 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">{upgrade.description}</p>
                {upgrade.tagline && upgrade.id !== "glamsterdam" && <p class="mb-2 text-sm text-slate-600 dark:text-slate-400">{upgrade.tagline}</p>}
                {upgrade.metaEipLink && (
                  <div class="mb-4">
                    <a href={upgrade.metaEipLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-purple-600 underline decoration-1 underline-offset-2 transition-colors hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300">
                      View Meta EIP Discussion
                      <ExternalLink class="h-4 w-4" aria-hidden="true" />
                    </a>
                  </div>
                )}
              </div>
              <div class="hidden lg:block">
                <span class={`rounded px-3 py-1 text-xs font-medium ${upgradeStatusBadgeClass(upgrade.status)}`}>{upgrade.status}</span>
              </div>
            </div>

            {upgrade.activationDetails && (
              <div class="mt-3 flex flex-wrap gap-2 text-xs text-slate-500 dark:text-slate-400">
                <span class="rounded bg-slate-100 px-2 py-1 dark:bg-slate-700">Block {upgrade.activationDetails.blockNumber.toLocaleString()}</span>
                <span class="rounded bg-slate-100 px-2 py-1 dark:bg-slate-700">Epoch {upgrade.activationDetails.epochNumber.toLocaleString()}</span>
                <span class="rounded bg-slate-100 px-2 py-1 dark:bg-slate-700">Slot {upgrade.activationDetails.slotNumber.toLocaleString()}</span>
              </div>
            )}

            {upgrade.id === "glamsterdam" && (
              <div class="-mx-6 mt-4">
                <div class="overflow-x-auto px-6 pb-3">
                  <nav class="flex min-w-max gap-6 border-slate-200 border-b dark:border-slate-700" aria-label="Glamsterdam sections">
                    {glamsterdamTabItems.map(([href, label]) => (
                      <a href={href} data-astro-prefetch="viewport" class={`-mb-px border-b-2 pb-2 text-sm font-medium whitespace-nowrap transition-colors ${pathname === href ? "border-purple-600 text-purple-700 dark:border-purple-400 dark:text-purple-300" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-200"}`}>
                        {label}
                      </a>
                    ))}
                  </nav>
                </div>
              </div>
            )}
          </header>

          <section class="relative mb-6 hidden min-h-[60px] overflow-visible rounded border border-slate-200 bg-white px-6 py-4 dark:border-slate-700 dark:bg-slate-800 sm:block" aria-label="Network upgrade timeline">
            <svg class="pointer-events-none absolute inset-x-0 top-1/2 h-6 w-full -translate-y-1/2 overflow-visible" viewBox="0 0 100 14" preserveAspectRatio="none" aria-hidden="true">
              <defs>
                <linearGradient id="upgrade-timeline-gradient" x1="6" y1="6" x2="94" y2="6" gradientUnits="userSpaceOnUse">
                  <stop offset="0%" stop-color="#e0e7ff" />
                  <stop offset="100%" stop-color="#bae6fd" />
                </linearGradient>
              </defs>
              <line x1="4" y1="8" x2="94" y2="8" stroke="url(#upgrade-timeline-gradient)" stroke-width="2" stroke-linecap="round"></line>
              <g transform="translate(94,8)">
                <polygon points="0,-3 2,0 0,3" fill="#bae6fd"></polygon>
              </g>
            </svg>
            <div class="relative z-10 flex min-h-6 w-full flex-row items-stretch justify-between px-12">
              {timelineUpgrades.map((item) => {
                const current = item.id === upgrade.id;
                const spacingClass = item.id === "fusaka" ? "mr-6" : item.id === "glamsterdam" ? "ml-6" : "";
                return (
                  <div class={`relative flex min-w-0 flex-1 flex-col items-center ${spacingClass}`}>
                      <a
                        href={item.path}
                        data-astro-prefetch="viewport"
                        aria-current={current ? "page" : undefined}
                      class={`mb-1 flex max-w-[180px] flex-col items-center truncate rounded border px-3 py-1.5 text-center leading-tight transition-all duration-200 ${current ? "border-purple-200 bg-white text-slate-900 shadow-sm dark:border-purple-600 dark:bg-slate-800 dark:text-slate-100" : "border-slate-200 bg-white text-slate-600 hover:border-slate-300 hover:shadow-sm dark:border-slate-600 dark:bg-slate-800 dark:text-slate-300 dark:hover:border-slate-500"}`}
                    >
                      <span class={`mb-0.5 text-xs leading-tight ${current ? "font-semibold text-slate-900 dark:text-slate-100" : "font-normal"}`}>{item.name.replace(" Upgrade", "")}</span>
                      <span class={`text-xs ${current ? "font-medium text-slate-600 dark:text-slate-300" : "text-slate-500 dark:text-slate-400"}`}>{item.activationDate ?? ""}</span>
                    </a>
                  </div>
                );
              })}
            </div>
            <div class="absolute z-20 flex flex-col items-center" style={`left: calc(${timelineMarkerPercent}%); top: 60%; transform: translate(-50%, -50%);`}>
              <span class="relative flex h-4 w-4">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-purple-200 opacity-40 dark:bg-purple-400"></span>
                <span class="relative inline-flex h-4 w-4 rounded-full border-2 border-purple-200 bg-purple-300 dark:border-purple-500 dark:bg-purple-400"></span>
              </span>
              <span class="mt-0.5 text-center text-[10px] font-medium leading-tight text-purple-300 dark:text-purple-400">we are here</span>
            </div>
          </section>

          <div class="grid gap-4 lg:grid-cols-[16rem_1fr] lg:gap-8" data-upgrade-filter-root>
            {upgrade.id === "glamsterdam" && (
              <div class="lg:hidden">
                <input type="search" data-upgrade-proposal-search placeholder="Filter EIPs..." class="mb-3 w-full rounded-md border border-slate-200 bg-white px-3 py-2 text-base text-slate-900 placeholder:text-slate-400 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500 dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 dark:placeholder:text-slate-400" />
                <div class="mb-3 grid grid-cols-3 gap-1 text-center text-xs">
                  <button type="button" data-upgrade-layer-filter="all" data-active="true" class="rounded border px-2 py-1 font-medium transition-colors data-[active=true]:border-slate-400 data-[active=true]:bg-white data-[active=true]:text-slate-700 data-[active=false]:border-slate-200 data-[active=false]:bg-white data-[active=false]:text-slate-500 data-[active=false]:hover:border-slate-300 dark:data-[active=true]:border-slate-400 dark:data-[active=true]:bg-slate-700 dark:data-[active=true]:text-slate-200 dark:data-[active=false]:border-slate-600 dark:data-[active=false]:bg-slate-800 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:border-slate-500">All</button>
                  <button type="button" data-upgrade-layer-filter="EL" data-active="false" class="rounded border px-2 py-1 font-medium transition-colors data-[active=true]:border-indigo-200 data-[active=true]:bg-indigo-100 data-[active=true]:text-indigo-700 data-[active=false]:border-slate-200 data-[active=false]:bg-white data-[active=false]:text-slate-500 data-[active=false]:hover:border-slate-300 dark:data-[active=true]:border-indigo-600 dark:data-[active=true]:bg-indigo-900/20 dark:data-[active=true]:text-indigo-300 dark:data-[active=false]:border-slate-600 dark:data-[active=false]:bg-slate-800 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:border-slate-500">EL</button>
                  <button type="button" data-upgrade-layer-filter="CL" data-active="false" class="rounded border px-2 py-1 font-medium transition-colors data-[active=true]:border-teal-200 data-[active=true]:bg-teal-100 data-[active=true]:text-teal-700 data-[active=false]:border-slate-200 data-[active=false]:bg-white data-[active=false]:text-slate-500 data-[active=false]:hover:border-slate-300 dark:data-[active=true]:border-teal-600 dark:data-[active=true]:bg-teal-900/20 dark:data-[active=true]:text-teal-300 dark:data-[active=false]:border-slate-600 dark:data-[active=false]:bg-slate-800 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:border-slate-500">CL</button>
                </div>
              </div>
            )}
            <aside class="hidden lg:block">
              <div class="sticky top-20 flex max-h-[calc(100vh-6rem)] flex-col">
                <h2 class="mb-4 flex items-center justify-between text-sm font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100">
                  <span>Contents</span>
                  <span class="text-slate-400 dark:text-slate-500" aria-hidden="true">↟</span>
                </h2>
                <input id="upgrade-proposal-search" data-upgrade-proposal-search type="search" placeholder="Filter EIPs..." class="mb-3 w-full rounded-md border border-slate-200 bg-white px-3 py-1.5 text-base text-slate-900 placeholder:text-slate-400 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-purple-500 lg:text-sm dark:border-slate-600 dark:bg-slate-700 dark:text-slate-100 dark:placeholder:text-slate-400" />
                <div class="mb-3 grid grid-cols-3 gap-1 text-center text-xs">
                  <button type="button" data-upgrade-layer-filter="all" data-active="true" class="rounded border px-2 py-1 font-medium transition-colors data-[active=true]:border-slate-400 data-[active=true]:bg-white data-[active=true]:text-slate-700 data-[active=false]:border-slate-200 data-[active=false]:bg-white data-[active=false]:text-slate-500 data-[active=false]:hover:border-slate-300 dark:data-[active=true]:border-slate-400 dark:data-[active=true]:bg-slate-700 dark:data-[active=true]:text-slate-200 dark:data-[active=false]:border-slate-600 dark:data-[active=false]:bg-slate-800 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:border-slate-500">All</button>
                  <button type="button" data-upgrade-layer-filter="EL" data-active="false" class="rounded border px-2 py-1 font-medium transition-colors data-[active=true]:border-indigo-200 data-[active=true]:bg-indigo-100 data-[active=true]:text-indigo-700 data-[active=false]:border-slate-200 data-[active=false]:bg-white data-[active=false]:text-slate-500 data-[active=false]:hover:border-slate-300 dark:data-[active=true]:border-indigo-600 dark:data-[active=true]:bg-indigo-900/20 dark:data-[active=true]:text-indigo-300 dark:data-[active=false]:border-slate-600 dark:data-[active=false]:bg-slate-800 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:border-slate-500">EL</button>
                  <button type="button" data-upgrade-layer-filter="CL" data-active="false" class="rounded border px-2 py-1 font-medium transition-colors data-[active=true]:border-teal-200 data-[active=true]:bg-teal-100 data-[active=true]:text-teal-700 data-[active=false]:border-slate-200 data-[active=false]:bg-white data-[active=false]:text-slate-500 data-[active=false]:hover:border-slate-300 dark:data-[active=true]:border-teal-600 dark:data-[active=true]:bg-teal-900/20 dark:data-[active=true]:text-teal-300 dark:data-[active=false]:border-slate-600 dark:data-[active=false]:bg-slate-800 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:border-slate-500">CL</button>
                </div>
                <nav class="min-h-0 flex-1 space-y-1 overflow-y-auto overflow-x-hidden pr-2 [scrollbar-gutter:stable]">
                  <a href="#overview" class="block overflow-hidden rounded bg-purple-100 px-3 py-2 text-sm font-medium text-purple-800 transition-colors dark:bg-purple-900/20 dark:text-purple-300">Overview</a>
                  {upgrade.id === "glamsterdam" && (
                    <a href="#timeline" class="block overflow-hidden rounded px-3 py-2 text-sm text-slate-600 transition-colors hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-700 dark:hover:text-slate-100">Timeline</a>
                  )}
                  {sidebarProposalGroups.length > 0 && (
                    <div class="mt-4 space-y-4">
                    {sidebarProposalGroups.map(({ stage, proposals }) => (
                      <div data-upgrade-proposal-group>
                        <div class="mb-2 flex items-center justify-between gap-2 px-3">
                          <p class="text-sm font-medium text-slate-900 dark:text-slate-100">{stage}</p>
                          <span data-upgrade-proposal-group-count class="text-xs text-slate-400 dark:text-slate-500">{proposals.length}</span>
                        </div>
                        <div class="space-y-1">
                          {proposals.map((proposal) => {
                            const layer = getProposalLayer(proposal);
                            const headliner = isHeadliner(proposal, forkKey);
                            const star =
                              headliner && forkKey?.toLowerCase() === "glamsterdam"
                                ? getInclusionStage(proposal, forkKey) === "Scheduled for Inclusion"
                                  ? "★"
                                  : "☆"
                                : headliner
                                  ? "★"
                                  : "";
                            const searchText = `${getProposalCode(proposal)} ${getLaymanTitle(proposal)} ${proposal.description}`.toLowerCase();
                            return (
                              <a
                                href={`/eips/${proposal.id}`}
                                data-astro-prefetch
                                data-upgrade-proposal-item
                                data-upgrade-proposal-link
                                data-layer={layer ?? ""}
                                data-search={searchText}
                                class="block overflow-hidden rounded px-6 py-1.5 text-xs leading-snug text-slate-500 transition-colors hover:bg-slate-50 hover:text-slate-700 dark:text-slate-400 dark:hover:bg-slate-700/50 dark:hover:text-slate-200"
                              >
                                <span class="block min-w-0 truncate">{star ? `${star} ` : ""}{getProposalCode(proposal)}: {getLaymanTitle(proposal)}</span>
                              </a>
                            );
                          })}
                        </div>
                      </div>
                    ))}
                    <p id="upgrade-proposal-empty" class="hidden px-3 py-3 text-xs text-slate-500 dark:text-slate-400">No matching proposals.</p>
                  </div>
                )}
                </nav>
              </div>
            </aside>

            <main class="min-w-0 space-y-6">
              <section id="overview" class="rounded border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
                <div class="mb-4 flex items-center gap-3">
                  <h2 class="text-lg font-semibold text-slate-900 dark:text-slate-100">Upgrade Overview</h2>
                  <a href="#overview" title="Copy link to overview" class="relative top-0.5 text-slate-400 transition-colors hover:text-slate-600 dark:hover:text-slate-300" aria-label="Copy link to overview">
                    <LinkIcon class="h-4 w-4" aria-hidden="true" />
                  </a>
                </div>
                {upgrade.id === "glamsterdam" && (
                  <div class="mb-6 flex items-start gap-3 rounded border border-blue-200 bg-blue-50 p-4 text-xs leading-relaxed text-blue-800 dark:border-blue-700 dark:bg-blue-900/20 dark:text-blue-200">
                    <Info class="mt-0.5 h-5 w-5 shrink-0 text-blue-500 dark:text-blue-300" aria-hidden="true" />
                    <p>Candidate EIPs are being fine-tuned, implemented, and tested on closed devnets. This process will determine which EIPs get Scheduled for Inclusion.</p>
                  </div>
                )}
                {upgrade.id === "hegota" && (
                  <div class="mb-6 rounded border border-blue-200 bg-blue-50 p-4 text-xs leading-relaxed text-blue-800 dark:border-blue-700 dark:bg-blue-900/20 dark:text-blue-200">
                    <p class="mb-1 font-medium text-blue-900 dark:text-blue-100">Headliner Selection Complete</p>
                    <p>Headliner selection process has concluded with FOCIL being SFI'd as a headliner and Frame Transaction being CFI'd.</p>
                  </div>
                )}
                <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
              {stageCounts.map(({ stage, count }) => (
                    <a href="#proposals" class="rounded bg-slate-50 p-4 text-center transition hover:bg-slate-100 hover:shadow-sm dark:bg-slate-700/50 dark:hover:bg-slate-700">
                      <div class="mb-1 text-2xl font-light text-slate-900 dark:text-slate-100">{count}</div>
                      <div class="mb-1 text-xs text-slate-500 dark:text-slate-400">EIP{count === 1 ? "" : "s"}</div>
                      <div class={`inline-block rounded px-2 py-1 text-xs font-medium ${overviewStageBadgeClass(stage)}`}>
                        {stage}
                      </div>
                    </a>
                  ))}
                </div>
              </section>

              {upgrade.id === "glamsterdam" && (
                <section id="timeline" class="space-y-6">
                  <div class="border-b border-slate-200 pb-4 dark:border-slate-700">
                    <div class="mb-2 flex items-center gap-3">
                      <h2 class="text-xl font-medium text-slate-900 dark:text-slate-100">Timeline</h2>
                      <a href="#timeline" title="Copy link to timeline" class="relative top-0.5 text-slate-400 transition-colors hover:text-slate-600 dark:hover:text-slate-300" aria-label="Copy link to timeline">
                        <LinkIcon class="h-4 w-4" aria-hidden="true" />
                      </a>
                    </div>
                    <p class="max-w-3xl text-sm text-slate-600 dark:text-slate-300">
                      The planning timeline for Glamsterdam, showing the progression from headliner selection to final implementation decisions.
                    </p>
                  </div>
                  <div class="mb-4">
                    <div class="rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
                      <div class="relative">
                        {GLAMSTERDAM_TIMELINE_PHASES.length > 1 && (
                          <div class="absolute bottom-5 left-5 top-5 hidden w-0.5 bg-slate-200 dark:bg-slate-600 lg:block"></div>
                        )}
                        <div class="space-y-8">
                          {GLAMSTERDAM_TIMELINE_PHASES.map((phase, index) => {
                            const highlighted = index === glamsterdamHighlightPhaseIndex;
                            return (
                              <div class="flex items-start gap-4">
                                <div class={`relative z-10 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border-2 text-sm font-semibold ${phaseStatusClass[phase.status]} ${highlighted ? "ring-4 ring-purple-100 dark:ring-purple-900/30" : ""}`}>
                                  <div class="absolute inset-0 rounded-full bg-white dark:bg-slate-800"></div>
                                  <div class={`absolute inset-0 rounded-full ${phase.status === "completed" ? "bg-emerald-100 dark:bg-emerald-900/20" : phase.status === "in-progress" ? "bg-purple-100 dark:bg-purple-900/20" : "bg-slate-100 dark:bg-slate-700"}`}></div>
                                  <div class="relative">{phaseStatusIcon[phase.status]}</div>
                                </div>
                                <div class="min-w-0 flex-1">
                                  <h3 class="mb-1 text-sm font-medium text-slate-900 dark:text-slate-100">{phase.title}</h3>
                                  <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">{phase.description}</p>
                                </div>
                              </div>
                            );
                          })}
                        </div>
                      </div>
                      {upgrade.metaEipLink && (
                        <div class="mt-4 border-slate-200 border-t pt-4 dark:border-slate-600">
                          <a href={upgrade.metaEipLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-xs text-purple-600 underline decoration-1 underline-offset-2 transition-colors hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300">
                            View full timeline details on Ethereum Magicians
                            <ExternalLink class="h-3.5 w-3.5" aria-hidden="true" />
                          </a>
                        </div>
                      )}
                    </div>
                  </div>
                </section>
              )}

          <section id="proposals" class="rounded-lg border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
            <div class="border-b border-slate-200 px-5 py-4 dark:border-slate-700">
              <h2 class="text-sm font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100">
                {getForkDisplayName(forkKey ?? upgrade.name)} Proposals
              </h2>
            </div>
            <div class="divide-y divide-slate-100 dark:divide-slate-700">
              {orderedForkProposals.length ? (
                orderedForkProposals.map((proposal) => {
                  const stage = getInclusionStage(proposal, forkKey);
                  const layer = getProposalLayer(proposal);
                  const searchText = `${getProposalCode(proposal)} ${getLaymanTitle(proposal)} ${proposal.description}`.toLowerCase();
                  return (
                    <a
                      href={`/eips/${proposal.id}`}
                      data-astro-prefetch
                      data-upgrade-proposal-item
                      data-upgrade-proposal-card
                      data-layer={layer ?? ""}
                      data-search={searchText}
                      class="flex flex-col gap-3 px-5 py-4 transition hover:bg-slate-50 sm:flex-row sm:items-start sm:justify-between dark:hover:bg-slate-700/30"
                    >
                      <div class="min-w-0">
                        <div class="mb-1 flex flex-wrap items-center gap-2">
                          <span class="font-mono text-sm font-medium text-purple-600 dark:text-purple-400">{getProposalCode(proposal)}</span>
                          {layer && <span class={`rounded px-2 py-0.5 text-xs font-medium ${layerBadgeClass(layer)}`}>{layer}</span>}
                          {stage !== "Unknown" && <span class={`rounded px-2 py-0.5 text-xs font-medium ${stageBadgeClass(stage)}`}>{stageLabel(stage)}</span>}
                        </div>
                        <h3 class="text-sm font-medium text-slate-900 dark:text-slate-100">{getLaymanTitle(proposal)}</h3>
                        <p class="mt-1 line-clamp-2 text-xs text-slate-600 dark:text-slate-400">{proposal.laymanDescription || proposal.description}</p>
                      </div>
                    </a>
                  );
                })
              ) : (
                <p class="px-5 py-4 text-sm text-slate-500 dark:text-slate-400">No tracked proposals for this upgrade yet.</p>
              )}
            </div>
          </section>
            </main>
          </div>

          {upgrade.clientTeamPerspectives?.length ? (
            <section class="mt-8 rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-700 dark:bg-slate-800">
              <h2 class="mb-4 text-sm font-semibold uppercase tracking-wide text-slate-900 dark:text-slate-100">Client Perspectives</h2>
              <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                {upgrade.clientTeamPerspectives.map((team) => (
                  <div class="rounded-lg border border-slate-200 bg-slate-50 p-3 dark:border-slate-700 dark:bg-slate-900/30">
                    <div class="mb-2 flex items-center justify-between gap-2">
                      <h3 class="text-sm font-medium text-slate-900 dark:text-slate-100">{team.teamName}</h3>
                      <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600 dark:bg-slate-700 dark:text-slate-300">{team.teamType}</span>
                    </div>
                    <div class="flex flex-wrap gap-2 text-xs">
                      {team.headlinerBlogPostUrl && <a href={team.headlinerBlogPostUrl} class="text-purple-600 underline underline-offset-2 dark:text-purple-400">Headliner view</a>}
                      {team.candidateBlogPostUrl && <a href={team.candidateBlogPostUrl} class="text-purple-600 underline underline-offset-2 dark:text-purple-400">Candidate view</a>}
                    </div>
                  </div>
                ))}
              </div>
            </section>
          ) : null}
        </div>
      </div>
      <script>
        const setupUpgradeProposalFilters = () => {
          const upgradeRoot = document.querySelector<HTMLElement>("[data-upgrade-filter-root]");
          if (!upgradeRoot || upgradeRoot.dataset.upgradeFiltersBound === "true") return;
          upgradeRoot.dataset.upgradeFiltersBound = "true";

          const proposalSearches = Array.from(upgradeRoot.querySelectorAll<HTMLInputElement>("[data-upgrade-proposal-search]"));
          const layerButtons = Array.from(upgradeRoot.querySelectorAll<HTMLButtonElement>("[data-upgrade-layer-filter]"));
          const proposalItems = Array.from(upgradeRoot.querySelectorAll<HTMLElement>("[data-upgrade-proposal-item]"));
          const proposalCards = Array.from(upgradeRoot.querySelectorAll<HTMLElement>("[data-upgrade-proposal-card]"));
          const proposalGroups = Array.from(upgradeRoot.querySelectorAll<HTMLElement>("[data-upgrade-proposal-group]"));
          const proposalEmpty = document.getElementById("upgrade-proposal-empty");
          let activeLayer = "all";

          const applyUpgradeProposalFilters = () => {
            const query = proposalSearches.find((input) => input.value.trim())?.value.trim().toLowerCase() ?? "";
            let visibleCards = 0;

            for (const item of proposalItems) {
              const layer = item.dataset.layer ?? "";
              const search = item.dataset.search ?? "";
              const matches =
                (activeLayer === "all" || layer === activeLayer) &&
                (!query || search.includes(query));
              item.hidden = !matches;
            }

            for (const card of proposalCards) {
              if (!card.hidden) visibleCards += 1;
            }

            for (const group of proposalGroups) {
              const groupItems = Array.from(group.querySelectorAll<HTMLElement>("[data-upgrade-proposal-link]"));
              const visibleGroupItems = groupItems.filter((item) => !item.hidden).length;
              const count = group.querySelector("[data-upgrade-proposal-group-count]");
              if (count) count.textContent = String(visibleGroupItems);
              group.hidden = visibleGroupItems === 0;
            }
            if (proposalEmpty) proposalEmpty.classList.toggle("hidden", visibleCards !== 0);
          };

          for (const button of layerButtons) {
            button.addEventListener("click", () => {
              activeLayer = button.dataset.upgradeLayerFilter ?? "all";
              for (const candidate of layerButtons) {
                candidate.dataset.active = String(candidate.dataset.upgradeLayerFilter === activeLayer);
              }
              applyUpgradeProposalFilters();
            });
          }

          for (const input of proposalSearches) {
            input.addEventListener("input", () => {
              for (const candidate of proposalSearches) {
                if (candidate !== input) candidate.value = input.value;
              }
              applyUpgradeProposalFilters();
            });
          }
          applyUpgradeProposalFilters();
        };

        setupUpgradeProposalFilters();
        document.addEventListener("astro:page-load", setupUpgradeProposalFilters);
      </script>
    </BaseLayout>
  ) : (
    <BaseLayout title="Upgrade Not Found - Forkcast" description="Upgrade not found.">
      <div class="min-h-screen bg-slate-50 p-6 dark:bg-slate-900">
        <div class="mx-auto max-w-4xl rounded-lg border border-slate-200 bg-white p-6 dark:border-slate-700 dark:bg-slate-800">
          <h1 class="text-xl font-semibold">Upgrade not found</h1>
        </div>
      </div>
    </BaseLayout>
  )
}
