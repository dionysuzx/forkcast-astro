---
import { ExternalLink } from "@lucide/astro";
import { GlamsterdamClientPriority } from "@/components/glamsterdam/GlamsterdamClientPriority";
import { GlamsterdamDevnetInclusion } from "@/components/glamsterdam/GlamsterdamDevnetInclusion";
import { GlamsterdamTestComplexity } from "@/components/glamsterdam/GlamsterdamTestComplexity";
import { devnetNetworkSnapshotRetrievedAt } from "@/domain/devnets/active-network";
import {
	glamsterdamDevnetDataLastUpdated,
	glamsterdamDevnetInclusionRows,
} from "@/domain/devnets/glamsterdam-inclusion";
import { layerBadgeClass, upgradeBadgeClass } from "@/domain/display";
import {
	glamsterdamPriorityLastUpdated,
	glamsterdamPriorityRows,
} from "@/domain/prioritization/client-priority";
import {
	getInclusionStage,
	getLaymanTitle,
	getProposalCode,
	getProposalLayer,
	getSpecificationUrl,
	type Proposal,
	proposalsForFork,
} from "@/domain/proposals/proposal";
import {
	glamsterdamTestComplexityRows,
	steelComplexityRetrievedAt,
	steelComplexitySource,
} from "@/domain/test-complexity/test-complexity";
import { getUpgradeById } from "@/domain/upgrades/upgrade";
import BaseLayout from "@/layouts/BaseLayout.astro";

const tabs = {
	stakeholders: "Stakeholders",
	"devnet-inclusion": "Devnet Inclusion",
	"client-priority": "Client Priority",
	"test-complexity": "Test Complexity",
};

const stakeholderOptions = [
	{ key: "appDevs", label: "App Developers" },
	{ key: "walletDevs", label: "Wallet Developers" },
	{ key: "endUsers", label: "End Users" },
	{ key: "layer2s", label: "Layer 2s" },
	{ key: "stakersNodes", label: "Stakers & Node Operators" },
	{ key: "toolingInfra", label: "Tooling & Infrastructure" },
] as const;

type StakeholderKey = (typeof stakeholderOptions)[number]["key"];

const stakeholderSections = [
	{
		id: "sfi",
		title: "Scheduled for Inclusion",
		hint: "Nearly certain. Plan accordingly.",
		stage: "Scheduled for Inclusion",
		accentColor: "border-emerald-400 dark:border-emerald-500",
		countColor: "text-emerald-600 dark:text-emerald-400",
		collapsible: false,
	},
	{
		id: "cfi",
		title: "Considered for Inclusion",
		hint: "Likely but not guaranteed.",
		stage: "Considered for Inclusion",
		accentColor: "border-amber-400 dark:border-amber-500",
		countColor: "text-amber-600 dark:text-amber-400",
		collapsible: false,
	},
	{
		id: "pfi",
		title: "Proposed for Inclusion",
		hint: "Still being evaluated.",
		stage: "Proposed for Inclusion",
		accentColor: "border-blue-400 dark:border-blue-500",
		countColor: "text-blue-600 dark:text-blue-400",
		collapsible: true,
	},
] as const;

const proposalsForStakeholder = (
	stakeholder: StakeholderKey,
	stage: string,
): Proposal[] =>
	proposals
		.filter((proposal) => proposal.stakeholderImpacts?.[stakeholder])
		.filter((proposal) => getInclusionStage(proposal, "Glamsterdam") === stage)
		.sort((a, b) => a.id - b.id);

export const getStaticPaths = () =>
	[
		"stakeholders",
		"devnet-inclusion",
		"client-priority",
		"test-complexity",
	].map((tab) => ({
		params: { tab },
	}));

const tab = Astro.params.tab as keyof typeof tabs;
const upgrade = getUpgradeById("glamsterdam");
const proposals = proposalsForFork("Glamsterdam");
const devnetRows =
	tab === "devnet-inclusion" ? glamsterdamDevnetInclusionRows() : [];
const devnetLastUpdated = glamsterdamDevnetDataLastUpdated();
const activeNetworkRetrievedAt = devnetNetworkSnapshotRetrievedAt();
const priorityRows = tab === "client-priority" ? glamsterdamPriorityRows() : [];
const priorityLastUpdated = glamsterdamPriorityLastUpdated();
const complexityRows =
	tab === "test-complexity" ? glamsterdamTestComplexityRows() : [];
const complexitySource = steelComplexitySource();
const complexityRetrievedAt = steelComplexityRetrievedAt();
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";
const tabItems = [
	["/upgrade/glamsterdam", "Overview"],
	["/upgrade/glamsterdam/stakeholders", "Stakeholders"],
	["/upgrade/glamsterdam/devnet-inclusion", "Devnet Inclusion"],
	["/upgrade/glamsterdam/client-priority", "Client Priority"],
	["/upgrade/glamsterdam/test-complexity", "Test Complexity"],
] as const;
---

<BaseLayout title={`Glamsterdam ${tabs[tab]} - Forkcast`} description={upgrade?.description ?? "Glamsterdam upgrade planning and proposal status."}>
  <div class="min-h-screen bg-slate-50 p-6 text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <div class="mx-auto max-w-4xl">
      <header class="mb-8">
        <a href="/upgrades" data-astro-prefetch class="mb-6 inline-block text-sm font-medium text-slate-600 transition-colors hover:text-slate-800 dark:text-slate-300 dark:hover:text-slate-100">
          ← All Network Upgrades
        </a>

        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between">
          <div class="flex-1">
            <div class="mb-3 flex items-center justify-between gap-3 lg:justify-start">
              <h1 class="text-3xl font-light tracking-tight text-slate-900 dark:text-slate-100">Glamsterdam Upgrade</h1>
              {upgrade && <span class={`rounded px-3 py-1 text-xs font-medium lg:hidden ${upgradeBadgeClass(upgrade.status)}`}>{upgrade.status}</span>}
            </div>
            {upgrade && <p class="mb-2 max-w-2xl text-base leading-relaxed text-slate-600 dark:text-slate-300">{upgrade.description}</p>}
            {upgrade?.metaEipLink && (
              <div class="mb-4">
                <a href={upgrade.metaEipLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1.5 text-sm text-purple-600 underline decoration-1 underline-offset-2 transition-colors hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300">
                  View Meta EIP Discussion
                  <ExternalLink class="h-4 w-4" aria-hidden="true" />
                </a>
              </div>
            )}
          </div>
          {upgrade && (
            <div class="hidden lg:block">
              <span class={`rounded px-3 py-1 text-xs font-medium ${upgradeBadgeClass(upgrade.status)}`}>{upgrade.status}</span>
            </div>
          )}
        </div>

        <div class="-mx-6 mt-4">
          <div class="overflow-x-auto px-6 pb-3">
            <nav class="flex min-w-max gap-6 border-slate-200 border-b dark:border-slate-700" aria-label="Glamsterdam sections">
              {tabItems.map(([href, label]) => (
                <a href={href} data-astro-prefetch="viewport" class={`-mb-px border-b-2 pb-2 text-sm font-medium whitespace-nowrap transition-colors ${pathname === href ? "border-purple-600 text-purple-700 dark:border-purple-400 dark:text-purple-300" : "border-transparent text-slate-500 hover:border-slate-300 hover:text-slate-700 dark:text-slate-400 dark:hover:border-slate-500 dark:hover:text-slate-200"}`}>
                  {label}
                </a>
              ))}
            </nav>
          </div>
        </div>
      </header>

      {
        tab === "stakeholders" ? (
          <div class="flex flex-col gap-6 md:flex-row" data-glamsterdam-stakeholders-root>
            <nav class="flex flex-row flex-wrap gap-1.5 md:w-48 md:flex-shrink-0 md:flex-col md:gap-0.5" aria-label="Stakeholder views">
              {stakeholderOptions.map((option, index) => (
                <button
                  type="button"
                  data-stakeholder-tab={option.key}
                  data-active={String(index === 0)}
                  class="rounded-md px-3 py-1.5 text-left text-sm transition-colors data-[active=true]:bg-purple-50 data-[active=true]:font-medium data-[active=true]:text-purple-700 data-[active=false]:text-slate-600 data-[active=false]:hover:bg-slate-100 data-[active=false]:hover:text-slate-900 dark:data-[active=true]:bg-purple-900/20 dark:data-[active=true]:text-purple-300 dark:data-[active=false]:text-slate-400 dark:data-[active=false]:hover:bg-slate-800 dark:data-[active=false]:hover:text-slate-200"
                >
                  {option.label}
                </button>
              ))}
            </nav>
            <div class="min-w-0 flex-1">
              {stakeholderOptions.map((option, index) => (
                <section data-stakeholder-panel={option.key} hidden={index !== 0}>
                  <p class="mb-4 text-sm text-slate-500 dark:text-slate-400">
                    EIPs that may affect <span class="font-semibold text-slate-900 dark:text-slate-100">{option.label.toLowerCase()}</span>, grouped by inclusion certainty.
                  </p>
                  <div class="space-y-8">
                    {stakeholderSections.map((section) => {
                      const sectionProposals = proposalsForStakeholder(option.key, section.stage);
                      if (sectionProposals.length === 0) return null;
                      return (
                        <section>
                          <div class={`mb-4 border-l-4 pl-4 ${section.accentColor}`}>
                            <div class="flex items-baseline gap-2">
                              <h2 class="text-lg font-medium text-slate-900 dark:text-slate-100">{section.title}</h2>
                              <span class={`text-sm ${section.countColor}`}>({sectionProposals.length})</span>
                              {section.collapsible && (
                                <button type="button" data-stakeholder-collapse class="ml-2 text-sm text-slate-400 transition-colors hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300">
                                  collapse
                                </button>
                              )}
                            </div>
                            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{section.hint}</p>
                          </div>
                          <div class="pl-4" data-stakeholder-section-list>
                            {sectionProposals.map((proposal) => {
                              const layer = getProposalLayer(proposal);
                              const impact = proposal.stakeholderImpacts?.[option.key]?.description;
                              return (
                                <article class="border-slate-200 border-b py-4 last:border-b-0 dark:border-slate-700">
                                  <div class="mb-2 flex items-start justify-between gap-4">
                                    <div class="min-w-0 flex-1">
                                      <a href={`/eips/${proposal.id}`} data-astro-prefetch class="group inline-flex flex-wrap items-baseline gap-2">
                                        <span class="font-mono text-sm text-slate-400 underline decoration-slate-300 underline-offset-2 dark:text-slate-400 dark:decoration-slate-600">
                                          {getProposalCode(proposal)}
                                        </span>
                                        <span class="font-medium text-slate-900 transition-colors group-hover:text-purple-600 dark:text-slate-100 dark:group-hover:text-purple-400">
                                          {getLaymanTitle(proposal)}
                                        </span>
                                        {layer && <span class={`rounded px-1.5 py-0.5 text-sm ${layerBadgeClass(layer)}`}>{layer}</span>}
                                      </a>
                                    </div>
                                    <div class="flex items-center gap-3 text-sm">
                                      {proposal.discussionLink && (
                                        <a href={proposal.discussionLink} target="_blank" rel="noopener noreferrer" class="text-slate-400 transition-colors hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300">
                                          forum
                                        </a>
                                      )}
                                      <a href={getSpecificationUrl(proposal)} target="_blank" rel="noopener noreferrer" class="text-slate-400 transition-colors hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300">
                                        spec
                                      </a>
                                    </div>
                                  </div>
                                  {impact && <p class="text-sm leading-relaxed text-slate-700 dark:text-slate-300">{impact}</p>}
                                  {proposal.laymanDescription && (
                                    <>
                                      <button type="button" data-stakeholder-description-toggle class="mt-2 text-sm text-slate-400 transition-colors hover:text-slate-600 dark:text-slate-400 dark:hover:text-slate-300">
                                        + what is this?
                                      </button>
                                      <div data-stakeholder-description hidden class="mt-2 overflow-hidden border-slate-200 border-l-2 pl-4 dark:border-slate-700">
                                        <p class="text-sm leading-relaxed text-slate-600 dark:text-slate-400">{proposal.laymanDescription}</p>
                                        <a href={`/eips/${proposal.id}`} data-astro-prefetch class="mt-2 inline-block text-sm text-purple-600 underline decoration-1 underline-offset-2 hover:text-purple-800 dark:text-purple-400 dark:hover:text-purple-300">
                                          View full EIP details →
                                        </a>
                                      </div>
                                    </>
                                  )}
                                </article>
                              );
                            })}
                          </div>
                        </section>
                      );
                    })}
                  </div>
                </section>
              ))}
            </div>
          </div>
        ) : tab === "devnet-inclusion" ? (
          <GlamsterdamDevnetInclusion rows={devnetRows} lastUpdated={devnetLastUpdated} activeNetworkRetrievedAt={activeNetworkRetrievedAt} client:load />
        ) : tab === "client-priority" ? (
          <GlamsterdamClientPriority rows={priorityRows} lastUpdated={priorityLastUpdated} client:load />
        ) : tab === "test-complexity" ? (
          <GlamsterdamTestComplexity rows={complexityRows} source={complexitySource} retrievedAt={complexityRetrievedAt} client:load />
        ) : null
      }
    </div>
  </div>
  <script>
    const setupGlamsterdamStakeholders = () => {
      const root = document.querySelector<HTMLElement>("[data-glamsterdam-stakeholders-root]");
      if (!root || root.dataset.stakeholdersBound === "true") return;
      root.dataset.stakeholdersBound = "true";

      const stakeholderTabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-stakeholder-tab]"));
      const stakeholderPanels = Array.from(root.querySelectorAll<HTMLElement>("[data-stakeholder-panel]"));

      const setStakeholderView = (key: string, updateUrl = true) => {
        if (!stakeholderTabs.length) return;
        const activeKey = stakeholderTabs.some((button) => button.dataset.stakeholderTab === key)
          ? key
          : (stakeholderTabs[0]?.dataset.stakeholderTab ?? "appDevs");
        for (const button of stakeholderTabs) button.dataset.active = String(button.dataset.stakeholderTab === activeKey);
        for (const panel of stakeholderPanels) panel.hidden = panel.dataset.stakeholderPanel !== activeKey;
        if (updateUrl) {
          const nextUrl = new URL(window.location.href);
          nextUrl.searchParams.set("view", activeKey);
          history.replaceState(null, "", nextUrl);
        }
      };

      for (const button of stakeholderTabs) {
        button.addEventListener("click", () => setStakeholderView(button.dataset.stakeholderTab ?? "appDevs"));
      }

      for (const button of root.querySelectorAll<HTMLButtonElement>("[data-stakeholder-description-toggle]")) {
        button.addEventListener("click", () => {
          const description = button.nextElementSibling as HTMLElement | null;
          if (!description) return;
          const nextHidden = !description.hidden;
          description.hidden = nextHidden;
          button.textContent = nextHidden ? "+ what is this?" : "− hide description";
        });
      }

      const initialStakeholder = new URLSearchParams(window.location.search).get("view");
      if (initialStakeholder) setStakeholderView(initialStakeholder, false);
    };

    setupGlamsterdamStakeholders();
    document.addEventListener("astro:page-load", setupGlamsterdamStakeholders);
  </script>
</BaseLayout>
