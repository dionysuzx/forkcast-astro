---
import { ChevronDown } from "@lucide/astro";

interface BreakoutOption {
	kind: string;
	label: string;
}

interface Props {
	callPath: string;
	options: BreakoutOption[];
}

const { callPath, options } = Astro.props;
---

<div class="relative z-50 mb-2 flex items-center gap-2" data-breakout-selector>
  <button
    type="button"
    class="relative z-[70] inline-flex min-w-36 items-center justify-between gap-2 rounded-md border border-slate-200 bg-white px-2.5 py-1 text-xs font-medium text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-purple-500/30 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800"
    data-breakout-selector-button
    aria-haspopup="menu"
    aria-expanded="false"
  >
    <span data-breakout-current-label>Main Call</span>
    <ChevronDown class="h-3.5 w-3.5 text-slate-400 transition-transform" data-breakout-selector-chevron aria-hidden="true" />
  </button>
  <div class="relative">
    <div
      class="absolute left-0 top-1 z-[80] hidden w-56 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg shadow-slate-900/10 dark:border-slate-700 dark:bg-slate-900 dark:shadow-black/30"
      data-breakout-selector-menu
      role="menu"
    >
      <a href={`/calls/${callPath}`} data-breakout-filter="main" class="block rounded-md px-3 py-1.5 text-sm font-medium text-slate-700 transition hover:bg-purple-50 hover:text-purple-700 data-[active=true]:bg-purple-50 data-[active=true]:text-purple-700 dark:text-slate-200 dark:hover:bg-purple-500/10 dark:hover:text-purple-200 dark:data-[active=true]:bg-purple-500/10 dark:data-[active=true]:text-purple-200" role="menuitem">
        Main Call
      </a>
      {options.map((option) => (
        <a href={`?breakout=${option.kind}`} data-breakout-filter={option.kind} class="block rounded-md px-3 py-1.5 text-sm text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 data-[active=true]:bg-purple-50 data-[active=true]:font-medium data-[active=true]:text-purple-700 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white dark:data-[active=true]:bg-purple-500/10 dark:data-[active=true]:text-purple-200" role="menuitem">
          {option.label}
        </a>
      ))}
    </div>
  </div>
</div>
