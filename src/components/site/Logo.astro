---
interface Props {
	size?: "xs" | "sm" | "md" | "lg" | "xl" | "2xl";
}

const { size = "sm" } = Astro.props;
const imageSizeClasses = {
	xs: "h-4",
	sm: "h-5",
	md: "h-6",
	lg: "h-7",
	xl: "h-8",
	"2xl": "h-10",
};
const symbolSizeClasses = {
	xs: "text-base",
	sm: "text-lg",
	md: "text-xl",
	lg: "text-2xl",
	xl: "text-3xl",
	"2xl": "text-4xl",
};
---

<a href="/" class="forkcast-logo" data-astro-prefetch>
  <span class={`fork-symbol ${symbolSizeClasses[size]}`} aria-hidden="true">⎇</span>
  <img
    src="/forkcast-logo.svg"
    alt="Forkcast"
    class={`forkcast-wordmark ${imageSizeClasses[size]} transition-opacity duration-200`}
  />
</a>
