---
import { ExternalLink } from "@lucide/astro";
import {
	macroPhaseCurrentLabel,
	macroPhaseSegments,
	macroPhaseSummary,
} from "@/domain/upgrades/macro-phase";
import type { NetworkUpgrade } from "@/domain/upgrades/upgrade";

interface Props {
	upgrade: NetworkUpgrade;
}

const { upgrade } = Astro.props;
const href = upgrade.disabled ? upgrade.externalLink : upgrade.path;
const isInteractive = Boolean(href);
const prefetchStrategy =
	!upgrade.disabled && href?.startsWith("/") ? "viewport" : undefined;
const segments = upgrade.hideProgressBar ? [] : macroPhaseSegments(upgrade);
const currentLabel = macroPhaseCurrentLabel(upgrade);
const summary = macroPhaseSummary(upgrade);
const targetLabel = upgrade.status === "Live" ? "Activated" : "Target";
const containerClass = [
	"group block h-full min-h-[13.625rem] rounded-lg border border-slate-200 bg-white p-6 transition",
	"dark:border-slate-700 dark:bg-slate-800",
	isInteractive
		? "hover:border-purple-300 hover:shadow-md dark:hover:border-purple-600 dark:hover:shadow-slate-700/20"
		: "cursor-not-allowed opacity-60",
].join(" ");
---

{
	href ? (
		<a
			href={href}
			target={upgrade.disabled && upgrade.externalLink ? "_blank" : undefined}
			rel={upgrade.disabled && upgrade.externalLink ? "noopener noreferrer" : undefined}
			data-astro-prefetch={prefetchStrategy}
			class={containerClass}
		>
			<div class="flex h-full flex-col">
				<div class="mb-5 flex items-start justify-between gap-3">
					<h3 class="text-xl font-medium leading-tight text-slate-900 dark:text-slate-100">
						{upgrade.name}
					</h3>
					{upgrade.disabled && upgrade.externalLink && (
						<ExternalLink class="mt-0.5 h-4 w-4 shrink-0 text-slate-400 dark:text-slate-500" aria-hidden="true" />
					)}
				</div>

				{segments.length > 0 && (
					<div class="mb-5">
						<div class="flex gap-1 pb-2.5" aria-label={`Upgrade phase: ${currentLabel}`}>
							{segments.map((segment, index) => {
								const isCurrent = segment.label === currentLabel || (upgrade.status === "Live" && index === segments.length - 1);
								return (
									<div class="relative flex-1" title={segment.description}>
										<div
											class:list={[
												"h-2 w-full rounded-full transition-colors",
												segment.state === "complete" && "bg-emerald-500 dark:bg-emerald-400",
												segment.state === "current" && "bg-purple-500 dark:bg-purple-400",
												segment.state === "upcoming" && "bg-slate-200 dark:bg-slate-700",
											]}
										/>
										{isCurrent && (
											<p
												class:list={[
													"absolute mt-0.5 whitespace-nowrap text-xs text-slate-500 dark:text-slate-400",
													index === 0 && "left-0",
													index === segments.length - 1 && "right-0",
													index > 0 && index < segments.length - 1 && "left-1/2 -translate-x-1/2",
												]}
											>
												{currentLabel}
											</p>
										)}
									</div>
								);
							})}
						</div>
					</div>
				)}

				<p class="flex-grow text-sm leading-relaxed text-slate-600 dark:text-slate-300">
					{summary}
				</p>

				{upgrade.activationDate && (
					<p class="mt-4 text-xs text-slate-500 dark:text-slate-400">
						<span class="font-medium">{targetLabel}:</span>{" "}
						{upgrade.activationDate}
					</p>
				)}
			</div>
		</a>
	) : (
		<div class={containerClass}>
			<div class="flex h-full flex-col">
				<div class="mb-5 flex items-start justify-between gap-3">
					<h3 class="text-xl font-medium leading-tight text-slate-500 dark:text-slate-400">
						{upgrade.name}
					</h3>
				</div>
				<p class="flex-grow text-sm leading-relaxed text-slate-400">
					{summary}
				</p>
			</div>
		</div>
	)
}
