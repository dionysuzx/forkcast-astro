{
	"name": "forkcast",
	"type": "module",
	"version": "0.0.1",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"data:complexity": "node scripts/sync-steel-complexity.mjs",
		"data:devnets": "node scripts/sync-devnet-networks.mjs",
		"data:upcoming-calls": "node scripts/sync-upcoming-calls.mjs",
		"data:forkcast-snapshot": "node scripts/sync-forkcast-data-snapshot.mjs",
		"test:data-snapshot": "node tests/forkcast-data-snapshot.test.mjs",
		"biome:check": "biome check .",
		"format": "biome check --write .",
		"verify": "pnpm test:data-snapshot && pnpm astro check && pnpm biome check . && pnpm build",
		"prepare": "husky"
	},
	"dependencies": {
		"@astrojs/mdx": "^5.0.4",
		"@astrojs/react": "^5.0.4",
		"@lucide/astro": "^1.14.0",
		"@radix-ui/react-slot": "^1.2.4",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"astro": "^6.3.1",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.14.0",
		"marked": "^18.0.3",
		"radix-ui": "^1.4.3",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"shadcn": "^4.7.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.1",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@biomejs/biome": "^2.4.14",
		"husky": "^9.1.7",
		"typescript": "^6.0.3"
	}
}
